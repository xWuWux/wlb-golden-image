#!/usr/bin/python3
"""Private export snapshots; no authorization or publication outside WLB (#20).

Only the trusted mover calls this helper. SOURCE and DEST must be below the
root-only queue. Untrusted directory entries are opened relative to pinned fds.
"""

import argparse
import hashlib
import json
import os
import pwd
import stat
import sys
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Literal, TypedDict, cast
from uuid import UUID


class Entry(TypedDict):
    path: str
    type: Literal["file", "directory"]
    size: int
    sha256: str


class Requester(TypedDict):
    uid: int
    username: str


class Manifest(TypedDict):
    schema_version: int
    request_id: str
    state: Literal["pending_review"]
    created_at: str
    requester: Requester
    original_name: str
    digest_algorithm: Literal["sha256-file", "sha256-inventory-v1"]
    sha256: str
    entries: list[Entry]


class SnapshotError(ValueError):
    """Stable failure code for a snapshot/resolve operation."""

    def __init__(self, code: str):
        self.code = code
        super().__init__(code)


@dataclass
class VerifiedBundle:
    """A v1 bundle with a pinned directory fd; the caller owns and must close it.

    ``bundle`` is informational only: it is not a capability. Use ``package_fd``
    with dir-relative opens for any later stage; closing the fd releases the pin.
    """

    request_id: UUID
    bundle: Path
    manifest: Manifest
    manifest_sha256: str
    payload_digest: str
    digest_algorithm: Literal["sha256-file", "sha256-inventory-v1"]
    package_fd: int

    def close(self) -> None:
        if self.package_fd >= 0:
            os.close(self.package_fd)
            self.package_fd = -1

    def __enter__(self) -> "VerifiedBundle":
        return self

    def __exit__(self, *_args: object) -> None:
        self.close()


# Safety ceilings, not export policy. Large transfers require a dedicated path.
MAX_ENTRIES = 100_000
MAX_DEPTH = 64
MAX_BYTES = 100 * 1024**3
CHUNK_SIZE = 1024**2
MAX_MANIFEST_BYTES = 64 * 1024**2
MAX_QUEUE_ENTRIES = 100_000
MAX_SCAN_MANIFEST_BYTES = 256 * 1024**2


def validate_manifest(value: object) -> Manifest:
    """Validate v1 metadata before reading payload; this does not authenticate it.

    Unknown fields are refused: a new contract requires an explicit reader update.
    bool is deliberately not accepted as an integer (True == 1 in Python).
    """
    if not isinstance(value, dict) or set(value) != set(Manifest.__annotations__):
        raise SnapshotError("invalid_manifest")
    if type(value["schema_version"]) is not int or value["schema_version"] != 1:
        raise SnapshotError("unsupported_manifest")
    if value["state"] != "pending_review":
        raise SnapshotError("unsupported_manifest")
    for key in ("request_id", "created_at", "original_name"):
        if not isinstance(value[key], str) or not value[key]:
            raise SnapshotError("invalid_manifest")
    try:
        request_id = UUID(value["request_id"])
        created_at = datetime.fromisoformat(value["created_at"])
    except ValueError as error:
        raise SnapshotError("invalid_manifest") from error
    if request_id.version != 4 or str(request_id) != value["request_id"]:
        raise SnapshotError("invalid_manifest")
    if created_at.utcoffset() != timezone.utc.utcoffset(created_at):
        raise SnapshotError("invalid_manifest")
    requester = value["requester"]
    if not isinstance(requester, dict) or set(requester) != set(Requester.__annotations__):
        raise SnapshotError("invalid_manifest")
    if type(requester["uid"]) is not int or requester["uid"] < 0:
        raise SnapshotError("invalid_manifest")
    if not isinstance(requester["username"], str) or not requester["username"]:
        raise SnapshotError("invalid_manifest")
    if value["digest_algorithm"] not in ("sha256-file", "sha256-inventory-v1"):
        raise SnapshotError("invalid_manifest")
    if not valid_digest(value["sha256"]):
        raise SnapshotError("invalid_manifest")
    entries = value["entries"]
    if not isinstance(entries, list) or not 1 <= len(entries) <= MAX_ENTRIES:
        raise SnapshotError("invalid_manifest")
    for entry in entries:
        if not isinstance(entry, dict) or set(entry) != set(Entry.__annotations__):
            raise SnapshotError("invalid_manifest")
        if not isinstance(entry["path"], str) or not entry["path"]:
            raise SnapshotError("invalid_manifest")
        if type(entry["size"]) is not int or entry["size"] < 0:
            raise SnapshotError("invalid_manifest")
        if entry["type"] == "file":
            if not valid_digest(entry["sha256"]):
                raise SnapshotError("invalid_manifest")
        elif entry["type"] == "directory":
            if entry["size"] != 0 or entry["sha256"] != "":
                raise SnapshotError("invalid_manifest")
        else:
            raise SnapshotError("invalid_manifest")
    return cast(Manifest, value)


def valid_digest(value: object) -> bool:
    """A v1 SHA-256 is exactly 64 lowercase hexadecimal characters."""
    return isinstance(value, str) and len(value) == 64 and all(c in "0123456789abcdef" for c in value)


def canonical(value: object) -> bytes:
    """Version 1: ASCII JSON, sorted keys, compact separators, no trailing newline."""
    return json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":")).encode("ascii")


def signature(st: os.stat_result) -> tuple[int, ...]:
    return (st.st_dev, st.st_ino, st.st_mode, st.st_uid, st.st_nlink, st.st_size, st.st_mtime_ns, st.st_ctime_ns)


def child_names(fd: int, limit: int) -> list[str]:
    """Bound memory before sorting an attacker-controlled directory."""
    names: list[str] = []
    with os.scandir(fd) as children:
        for child in children:
            if len(names) >= limit:
                raise SnapshotError("limit_exceeded")
            names.append(child.name)
    return sorted(names, key=os.fsencode)


def inventory_at(parent_fd: int, name: str, destination: Path | None = None) -> list[Entry]:
    """Copy or verify one entry relative to a pinned parent directory fd.

    The parent fd is borrowed and remains owned by the caller. All children are
    opened relative to pinned fds with O_NOFOLLOW/O_NONBLOCK; unsafe or changing
    trees fail without returning a partial inventory.
    """
    entries: list[Entry] = []
    total = 0
    owner: int | None = None

    def visit(parent: int, child: str, relative: str, target: Path | None, depth: int) -> None:
        nonlocal total, owner
        if depth > MAX_DEPTH or len(entries) >= MAX_ENTRIES:
            raise SnapshotError("limit_exceeded")
        fd = os.open(child, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
        try:
            before = os.fstat(fd)
            if owner is None:
                owner = before.st_uid
            if before.st_uid != owner:
                raise SnapshotError("mixed_owner")
            if stat.S_ISREG(before.st_mode):
                if before.st_nlink != 1:
                    raise SnapshotError("hardlink")
                total += before.st_size
                if total > MAX_BYTES:
                    raise SnapshotError("limit_exceeded")
                digest = hashlib.sha256()
                out = None
                try:
                    if target is not None:
                        out = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                    remaining = before.st_size
                    while remaining:
                        chunk = os.read(fd, min(CHUNK_SIZE, remaining))
                        if not chunk:
                            raise SnapshotError("source_changed")
                        digest.update(chunk)
                        if out is not None:
                            view = memoryview(chunk)
                            while view:
                                written = os.write(out, view)
                                if written == 0:
                                    raise OSError("short write")
                                view = view[written:]
                        remaining -= len(chunk)
                    if os.read(fd, 1):
                        raise SnapshotError("source_changed")
                    if out is not None:
                        os.fsync(out)
                finally:
                    if out is not None:
                        os.close(out)
                entries.append(Entry(path=relative, type="file", size=before.st_size, sha256=digest.hexdigest()))
            elif stat.S_ISDIR(before.st_mode):
                entries.append(Entry(path=relative, type="directory", size=0, sha256=""))
                if target is not None:
                    target.mkdir(mode=0o700)
                children = child_names(fd, MAX_ENTRIES - len(entries))
                for child_name in children:
                    child_path = child_name if relative == "." else relative + "/" + child_name
                    visit(fd, child_name, child_path, target / child_name if target is not None else None, depth + 1)
                if children != child_names(fd, MAX_ENTRIES):
                    raise SnapshotError("source_changed")
                if target is not None:
                    sync_dir(target)
            else:
                raise SnapshotError("unsupported_type")
            if signature(before) != signature(os.fstat(fd)):
                raise SnapshotError("source_changed")
            if signature(before) != signature(os.stat(child, dir_fd=parent, follow_symlinks=False)):
                raise SnapshotError("source_changed")
        finally:
            os.close(fd)

    visit(parent_fd, name, ".", destination, 0)
    return entries


def inventory(source: Path, destination: Path | None = None) -> list[Entry]:
    """Path wrapper for create(); verification uses inventory_at(package_fd, ...)."""
    parent = os.open(source.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        return inventory_at(parent, source.name, destination)
    finally:
        os.close(parent)


def sync_dir(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def payload_digest(entries: list[Entry]) -> str:
    if len(entries) == 1 and entries[0]["type"] == "file":
        return entries[0]["sha256"]
    return hashlib.sha256(canonical(entries)).hexdigest()


def create(source: Path, destination: Path, original_name: str, request_id: str) -> Manifest:
    """Build an unpublished bundle; caller publishes by rename after success only.

    Arguments: captured SOURCE, new DEST, exact original basename, opaque request ID.
    Return the v1 manifest. Partial destination and source remain on errors.
    """
    before = source.lstat()
    destination.mkdir(mode=0o700)
    entries = inventory(source, destination / "payload")
    if signature(before) != signature(source.lstat()):
        raise SnapshotError("source_changed")
    try:
        username = pwd.getpwuid(before.st_uid).pw_name
    except KeyError:
        username = str(before.st_uid)
    manifest: Manifest = {
        "schema_version": 1,
        "request_id": request_id,
        "state": "pending_review",
        "created_at": datetime.now(timezone.utc).isoformat(),
        "requester": {"uid": before.st_uid, "username": username},
        "original_name": original_name,
        "digest_algorithm": "sha256-file" if stat.S_ISREG(before.st_mode) else "sha256-inventory-v1",
        "sha256": payload_digest(entries),
        "entries": entries,
    }
    validate_manifest(manifest)
    with (destination / "manifest.json").open("xb") as output:
        os.chmod(output.name, 0o600)
        output.write(canonical(manifest) + b"\n")
        output.flush()
        os.fsync(output.fileno())
    sync_dir(destination)
    return manifest


class _DuplicateKeyError(ValueError):
    pass


def _no_duplicate_keys(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise _DuplicateKeyError(key)
        result[key] = value
    return result


def _load_json(raw: bytes) -> object:
    """Strict JSON: duplicate keys, bad UTF-8 and excessive nesting are invalid."""
    try:
        return json.loads(raw, object_pairs_hook=_no_duplicate_keys)
    except (json.JSONDecodeError, UnicodeDecodeError, RecursionError, _DuplicateKeyError) as error:
        raise SnapshotError("invalid_manifest") from error


def verify_open_bundle(package_fd: int, raw_manifest: bytes) -> Manifest:
    """Verify payload against already-read manifest bytes and a pinned package fd.

    The package fd is borrowed; the caller keeps it open and closes it. This
    function never reopens the bundle or its manifest by path.
    """
    manifest = validate_manifest(_load_json(raw_manifest))
    entries = inventory_at(package_fd, "payload")
    algorithm = "sha256-file" if entries[0]["type"] == "file" else "sha256-inventory-v1"
    if (
        entries != manifest.get("entries")
        or payload_digest(entries) != manifest.get("sha256")
        or algorithm != manifest.get("digest_algorithm")
    ):
        raise SnapshotError("integrity_mismatch")
    return manifest


def verify(bundle: Path) -> Manifest:
    """Verify a bundle by opening it once, then using only fd-relative reads.

    Manifest is local root-owned metadata, not a signature or evidence of approval.
    Legacy queue entries without a v1 manifest are deliberately refused.
    """
    try:
        package_fd = os.open(bundle, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except FileNotFoundError:
        raise
    except OSError as error:
        raise SnapshotError("unsafe_entry") from error
    try:
        return verify_open_bundle(package_fd, _read_manifest(package_fd))
    finally:
        os.close(package_fd)


def _read_manifest(package_fd: int) -> bytes:
    """Read one regular manifest without following a symlink or blocking on a FIFO."""
    try:
        fd = os.open("manifest.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=package_fd)
    except FileNotFoundError:
        raise
    except OSError as error:
        raise SnapshotError("unsafe_entry") from error
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_MANIFEST_BYTES:
            raise SnapshotError("unsafe_entry")
        chunks: list[bytes] = []
        remaining = info.st_size
        while remaining:
            chunk = os.read(fd, min(CHUNK_SIZE, remaining))
            if not chunk:
                raise SnapshotError("source_changed")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(fd, 1):
            raise SnapshotError("source_changed")
        return b"".join(chunks)
    finally:
        os.close(fd)


def _close_matches(matches: list[tuple[str, Manifest, bytes, int]]) -> None:
    for _name, _manifest, _raw, package_fd in matches:
        if package_fd >= 0:
            os.close(package_fd)
    matches.clear()


def resolve_request(queue: Path, request_id: UUID) -> VerifiedBundle:
    """Resolve exactly one verified v1 bundle by request UUID inside a private queue.

    The caller supplies a canonical queue and a UUID, never a bundle path. The
    returned ``VerifiedBundle`` owns a pinned package fd; use it for any later
    dir-relative read. A legacy or malformed entry does not hide a valid
    unrelated request; if no valid match exists, the resolver fails closed.
    """
    if not isinstance(request_id, UUID):
        raise TypeError("request_id must be a UUID")
    if request_id.version != 4:
        raise SnapshotError("invalid_request_id")
    target = str(request_id)
    matches: list[tuple[str, Manifest, bytes, int]] = []
    has_legacy = False
    has_unsafe = False
    has_invalid = False
    invalid_target = False
    scan_bytes = 0

    try:
        resolved_queue = queue.resolve(strict=True)
    except OSError as error:
        raise SnapshotError("unsafe_entry") from error
    if resolved_queue != queue.absolute():
        raise SnapshotError("unsafe_entry")

    try:
        queue_fd = os.open(queue, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as error:
        raise SnapshotError("unsafe_entry") from error

    try:
        with os.scandir(queue_fd) as children:
            count = 0
            for child in children:
                count += 1
                if count > MAX_QUEUE_ENTRIES:
                    raise SnapshotError("limit_exceeded")
                name = child.name
                # .mover.lock and .incoming.* are service internals, never requests.
                if name.startswith("."):
                    continue
                try:
                    info = os.stat(name, dir_fd=queue_fd, follow_symlinks=False)
                except OSError:
                    has_unsafe = True
                    continue
                if stat.S_ISLNK(info.st_mode):
                    has_unsafe = True
                    continue
                if not stat.S_ISDIR(info.st_mode):
                    has_legacy = True
                    continue
                package_fd = -1
                try:
                    try:
                        package_fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=queue_fd)
                    except OSError:
                        has_unsafe = True
                        continue
                    try:
                        raw = _read_manifest(package_fd)
                    except FileNotFoundError:
                        has_legacy = True
                        continue
                    except SnapshotError as error:
                        if error.code == "unsafe_entry":
                            has_unsafe = True
                        else:
                            has_invalid = True
                        continue
                    except OSError:
                        has_invalid = True
                        continue
                    scan_bytes += len(raw)
                    if scan_bytes > MAX_SCAN_MANIFEST_BYTES:
                        raise SnapshotError("limit_exceeded")
                    try:
                        candidate = _load_json(raw)
                    except SnapshotError:
                        has_invalid = True
                        continue
                    try:
                        manifest = validate_manifest(candidate)
                    except SnapshotError:
                        if isinstance(candidate, dict) and candidate.get("request_id") == target:
                            invalid_target = True
                        has_invalid = True
                        continue
                    if manifest["request_id"] != target:
                        continue
                    if matches:
                        raise SnapshotError("duplicate_request")
                    matches.append((name, manifest, raw, package_fd))
                    package_fd = -1
                finally:
                    if package_fd >= 0:
                        os.close(package_fd)

        if not matches:
            if invalid_target:
                raise SnapshotError("invalid_manifest")
            if has_unsafe:
                raise SnapshotError("unsafe_entry")
            if has_legacy:
                raise SnapshotError("legacy_entry")
            if has_invalid:
                raise SnapshotError("invalid_manifest")
            raise SnapshotError("not_found")

        name, manifest, raw, package_fd = matches[0]
        if invalid_target:
            _close_matches(matches)
            raise SnapshotError("duplicate_request")
        try:
            verified = verify_open_bundle(package_fd, raw)
        except SnapshotError:
            _close_matches(matches)
            raise
        except OSError as error:
            _close_matches(matches)
            raise SnapshotError("source_changed") from error
        if verified != manifest:
            _close_matches(matches)
            raise SnapshotError("source_changed")
        bundle = queue / name
        matches.clear()
        return VerifiedBundle(
            request_id=UUID(manifest["request_id"]),
            bundle=bundle,
            manifest=manifest,
            manifest_sha256=hashlib.sha256(raw).hexdigest(),
            payload_digest=manifest["sha256"],
            digest_algorithm=manifest["digest_algorithm"],
            package_fd=package_fd,
        )
    except Exception:
        _close_matches(matches)
        raise
    finally:
        os.close(queue_fd)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    new = commands.add_parser("create")
    new.add_argument("source", type=Path)
    new.add_argument("destination", type=Path)
    new.add_argument("original_name")
    new.add_argument("request_id")
    check = commands.add_parser("verify")
    check.add_argument("bundle", type=Path)
    resolve = commands.add_parser("resolve")
    resolve.add_argument("queue", type=Path)
    resolve.add_argument("request_id", type=UUID)
    resolve.add_argument("--show-path", action="store_true", help="include the sensitive bundle path in stdout")
    args = parser.parse_args()
    try:
        if args.command == "create":
            manifest = create(args.source, args.destination, args.original_name, args.request_id)
        elif args.command == "verify":
            manifest = verify(args.bundle)
        else:
            with resolve_request(args.queue, args.request_id) as request:
                payload = {
                    "request_id": str(request.request_id),
                    "manifest_sha256": request.manifest_sha256,
                    "payload_digest": request.payload_digest,
                    "digest_algorithm": request.digest_algorithm,
                }
                if args.show_path:
                    payload["bundle"] = str(request.bundle)
                print(json.dumps(payload, ensure_ascii=True, sort_keys=True))
            return 0
        print(manifest["sha256"])
        return 0
    except (OSError, ValueError, RecursionError) as error:
        code = getattr(error, "code", type(error).__name__)
        print("export_snapshot_failed: " + code, file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
