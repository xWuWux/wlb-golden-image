#!/usr/bin/env python3
"""wlb-export — operatorskie CLI do inspekcji kolejki eksportu i przygotowania wydania (#20, interim).

Ułatwia ręczne wyciąganie wyników ze śluzy, dopóki pełny proces #20 (zgoda Lidera/Kontrolera,
publikacja, audyt) nie jest wdrożony. Operacje:

  wlb-export list                     # metadane wniosków w kolejce (bez treści payloadu)
  wlb-export show <request_id>        # zweryfikowany deskryptor jednego wniosku (resolve + JSON)
  wlb-export verify <request_id>      # integrity_check pakietu (kod wyjścia)
  wlb-export stage <request_id>       # kopia zweryfikowanego payloadu do obszaru czytelnego dla
                                      #   konta SSH operatora (do ręcznego scp na własną maszynę)
  wlb-export staged-clear <request_id>  # usuń staged pliki (retencja RĘCZNA — decyzja operatora)

Bezpieczeństwo:
- Nigdy nie przyjmuje DOWOLNEJ ścieżki bundle — tylko request_id, rozwiązywany przez
  `wlb-export-snapshot resolve` (E1, #20). To zamyka furtkę opisaną w RB-eksport-kolejka.md.
- `stage` kopiuje payload dopiero po `verify`; loguje zdarzenie (authpriv → SIEM).
- Model interim (decyzje właściciela): retencja staged RĘCZNA (brak timera), admin = Kontroler
  (ten sam operator inspekcjonuje i wydaje), bez wymuszonego powodu/ticketu.

Zmienne środowiska (nadpisywalne w testach):
  WLB_EXPORT_QUEUE     kolejka (domyślnie /workspace/.wlb-export-queue)
  WLB_EXPORT_STAGING   obszar staged, czytelny dla konta SSH operatora (domyślnie /var/lib/wlb-export-staging)
  WLB_EXPORT_SNAPSHOT  ścieżka helpera wlb-export-snapshot (domyślnie /usr/local/sbin/wlb-export-snapshot)
  WLB_EXPORT_ADMIN     konto, na które chown-ujemy staged pliki (domyślnie root; chown tylko jako root)
"""

from __future__ import annotations

import contextlib
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

QUEUE = Path(os.environ.get("WLB_EXPORT_QUEUE", "/workspace/.wlb-export-queue"))
STAGING = Path(os.environ.get("WLB_EXPORT_STAGING", "/var/lib/wlb-export-staging"))
SNAPSHOT = os.environ.get("WLB_EXPORT_SNAPSHOT", "/usr/local/sbin/wlb-export-snapshot")
ADMIN = os.environ.get("WLB_EXPORT_ADMIN", "root")


def _log(msg: str) -> None:
    """Minimalny ślad audytowy do syslog/SIEM (authpriv). Nie przerywa operacji przy błędzie loggera."""
    with contextlib.suppress(OSError):
        # logger: zaufane polecenie systemowe; argumenty bez treści użytkownika.
        subprocess.run(  # noqa: S603
            ["logger", "-t", "wlb-export", "-p", "authpriv.notice", "--", msg],  # noqa: S607
            check=False,
        )


def _snapshot(*args: str) -> subprocess.CompletedProcess[str]:
    # S603: polecenie stałe (SNAPSHOT z env operatora/roota), argumenty bez treści użytkownika.
    return subprocess.run(  # noqa: S603
        [SNAPSHOT, *args],
        check=False,
        capture_output=True,
        text=True,
    )


def _resolve(request_id: str) -> dict:
    """Rozwiązuje request_id przez wlb-export-snapshot (E1). Fail-closed: błąd = wyjątek, bez bundle."""
    proc = _snapshot("resolve", str(QUEUE), request_id)
    if proc.returncode != 0:
        raise SystemExit(f"nie rozwiązano wniosku {request_id}: {proc.stderr.strip() or 'błąd resolve'}")
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"resolve zwrócił niepoprawny JSON dla {request_id}: {exc}") from exc


def _read_manifest(bundle: Path) -> dict | None:
    """Czyta manifest.json wniosku; None, gdy brak/niepoprawny (wpis legacy)."""
    try:
        with (bundle / "manifest.json").open(encoding="utf-8") as fh:
            value = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(value, dict) or value.get("schema_version") != 1:
        return None
    return value


def cmd_list() -> int:
    """Wypisuje metadane wniosków w kolejce. TYLKO metadane manifestu — nigdy treść payloadu."""
    if not QUEUE.is_dir():
        print(f"kolejka {QUEUE} nie istnieje lub niedostępna", file=sys.stderr)
        return 1
    rows = []
    for entry in sorted(QUEUE.iterdir()):
        if not entry.is_dir() or entry.name.startswith("."):
            continue
        manifest = _read_manifest(entry)
        if manifest is None:
            rows.append((entry.name, "LEGACY", "", "", "", "nieweryfikowalny"))
            continue
        files = [e for e in manifest.get("entries", []) if e.get("type") == "file"]
        total = sum(int(e.get("size", 0)) for e in files)
        rows.append(
            (
                manifest.get("request_id", "?"),
                manifest.get("requester", {}).get("username", "?"),
                manifest.get("created_at", "?"),
                str(len(files)),
                str(total),
                manifest.get("state", "?"),
            )
        )
    if not rows:
        print("(kolejka pusta)")
        return 0
    print(f"{'REQUEST_ID':36}  {'BADACZ':16}  {'UTWORZONO':20}  {'PLIKI':>5}  {'ROZMIAR':>12}  STAN")
    for r in rows:
        print(f"{r[0]:36}  {r[1]:16}  {r[2]:20}  {r[3]:>5}  {r[4]:>12}  {r[5]}")
    return 0


def cmd_show(request_id: str) -> int:
    """Zweryfikowany deskryptor jednego wniosku (resolve → JSON). Bez treści payloadu i nazw plików."""
    info = _resolve(request_id)
    print(json.dumps(info, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


def cmd_verify(request_id: str) -> int:
    """Integrity_check pakietu przez wlb-export-snapshot verify. Kod wyjścia != 0 przy niezgodności."""
    info = _resolve(request_id)
    proc = _snapshot("verify", info["bundle"])
    if proc.returncode != 0:
        print(f"verify NIEUDANY dla {request_id}: {proc.stderr.strip()}", file=sys.stderr)
        return 1
    print(f"OK: {request_id} przeszedł verify (sha256={info['manifest_sha256']})")
    return 0


def cmd_stage(request_id: str) -> int:
    """Kopiuje ZWERYFIKOWANY payload do obszaru staged czytelnego dla operatora (do ręcznego scp).

    Nie podejmuje decyzji o eksporcie — przygotowuje tylko plik. Retencja staged jest RĘCZNA
    (staged-clear). Każde stage loguje zdarzenie export_staged (authpriv → SIEM).
    """
    info = _resolve(request_id)
    verify = _snapshot("verify", info["bundle"])
    if verify.returncode != 0:
        print(f"stage przerwane — verify NIEUDANY dla {request_id}: {verify.stderr.strip()}", file=sys.stderr)
        return 1
    payload = Path(info["bundle"]) / "payload"
    if not payload.exists():
        print(f"stage przerwane — brak payloadu w pakiecie {request_id}", file=sys.stderr)
        return 1
    dest = STAGING / request_id
    if dest.exists():
        print(f"stage przerwane — staged {dest} już istnieje (użyj staged-clear, retencja ręczna)", file=sys.stderr)
        return 1
    STAGING.mkdir(parents=True, exist_ok=True)
    try:
        if payload.is_dir():
            shutil.copytree(payload, dest)
        else:
            dest.mkdir(parents=True)
            shutil.copy2(payload, dest / payload.name)
    except OSError as exc:
        print(f"stage NIEUDANE dla {request_id}: {exc}", file=sys.stderr)
        return 1
    # chown tylko jako root (test jako nie-root pomija); staged ma być czytelny dla konta SSH operatora
    if os.geteuid() == 0 and ADMIN != "root":
        shutil.chown(dest, user=ADMIN)
        for child in dest.rglob("*"):
            shutil.chown(child, user=ADMIN)
    _log(
        f"export_staged request_id={request_id} sha256={info['manifest_sha256']} "
        f"operator={os.environ.get('SUDO_USER', os.environ.get('USER', 'root'))} dest={dest}"
    )
    print(f"OK: staged {request_id} w {dest}")
    print(f"   skopiuj na swoją maszynę (scp), potem sprzątnij: wlb-export staged-clear {request_id}")
    return 0


def cmd_staged_clear(request_id: str) -> int:
    """Usuwa staged pliki wniosku (retencja ręczna — operator sprząta po scp)."""
    dest = STAGING / request_id
    if not dest.exists():
        print(f"(brak staged dla {request_id})")
        return 0
    shutil.rmtree(dest)
    _log(f"export_staged_cleared request_id={request_id} dest={dest}")
    print(f"OK: usunięto staged {request_id}")
    return 0


def main(argv: list[str]) -> int:
    if len(argv) < 1:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "list":
        return cmd_list()
    if cmd in ("show", "verify", "stage", "staged-clear"):
        if len(rest) != 1:
            print(f"użycie: wlb-export {cmd} <request_id>", file=sys.stderr)
            return 2
        return {
            "show": cmd_show,
            "verify": cmd_verify,
            "stage": cmd_stage,
            "staged-clear": cmd_staged_clear,
        }[cmd](rest[0])
    print(f"nieznana komenda: {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
