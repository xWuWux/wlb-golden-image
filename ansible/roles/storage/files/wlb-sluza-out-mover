#!/usr/bin/env bash
# Śluza wyjściowa: każdy wpis zapisany przez badacza w /sluza-out trafia do kolejki
# zatwierdzenia eksportu i znika z widoku badacza. Każde przeniesienie jest logowane
# (identyfikator badacza, znacznik czasu, suma SHA-256) do syslogu, a stamtąd do SIEM.
#
#   wlb-sluza-out-mover          # usługa: działa w pętli (inotify + przegląd co 30 s)
#   wlb-sluza-out-mover --once   # jeden przegląd i koniec
set -euo pipefail

IMAGE_CONF=${WLB_IMAGE_CONF:-/etc/wlb/image.conf}
# shellcheck source=/dev/null
[[ -r $IMAGE_CONF ]] && . "$IMAGE_CONF"
SRC=${WLB_SLUZA_OUT:-/sluza-out}
QUEUE=${WLB_EXPORT_QUEUE:-/workspace/.wlb-export-queue}
REJECTED=${WLB_SLUZA_REJECTED:-/sluza-odrzucone} # katalog zwrotny widoczny dla badacza (#162/IMG-008)
SNAPSHOT="$(dirname -- "$(readlink -f -- "$0")")/wlb-export-snapshot"
DIR_SETTLE_SECONDS=${WLB_DIR_SETTLE_SECONDS:-120} # katalog uznajemy za kompletny po 2 min bez zmian

log() { logger -t wlb-sluza-out -p authpriv.notice -- "$*"; }

# Zwrotna informacja dla badacza: dlaczego wpis zniknął ze śluzy (#162/IMG-008 pkt 3). /sluza-odrzucone
# jest czytelny dla badacza (0750, jak /sluza-in). Zawiera TYLKO powód — NIE zwraca odrzuconej
# zawartości (bywa wrażliwa/duża; przy błędzie migawki czeka w kwarantannie na operatora, a konkretny
# powód celowo tam zostaje). Nigdy nie może zatrzymać movera: każdy błąd kończy funkcję cicho (return 0).
reject_notice() { # reject_notice UID RAW_NAME REASON
  local uid=$1 reason=$3 name ts hint f
  [[ -d $REJECTED ]] || return 0
  name=$(printf '%s' "$2" | LC_ALL=C tr -c 'a-zA-Z0-9._-' '_')
  name=${name:0:120}
  ts=$(date -u +%Y%m%dT%H%M%SZ) || return 0
  case $reason in
    unsupported_type)
      hint="Dowiązanie symboliczne, nazwany potok lub plik specjalny nie są dozwolone do eksportu. Wyeksportuj zwykły plik albo katalog z kopią danych (nie dowiązanie)."
      ;;
    snapshot_error)
      hint="Nie udało się przygotować wniosku. Najczęstsze przyczyny: przekroczony limit wniosku (maks. 100 GiB albo 100 000 plików), dowiązanie twarde, albo pliki o różnych właścicielach w jednym wniosku (np. plik skopiowany z /data-mart należący do root). Usuń niepasujący element i spróbuj ponownie; w razie wątpliwości zgłoś operatorowi."
      ;;
    *)
      hint="Wniosek odrzucony przez śluzę wyjściową."
      ;;
  esac
  f=$(mktemp "$REJECTED/${ts}_${name}.powod.XXXXXX" 2>/dev/null) || return 0
  {
    printf 'Eksport przez śluzę wyjściową został odrzucony.\n\n'
    printf 'Element:    %s\n' "$name"
    printf 'Czas (UTC): %s\n' "$ts"
    printf 'Powód:      %s\n\n' "$reason"
    printf '%s\n' "$hint"
  } >"$f" 2>/dev/null || {
    rm -f -- "$f" 2>/dev/null || true
    return 0
  }
  chmod 0640 -- "$f" 2>/dev/null || true
  chown "$uid" -- "$f" 2>/dev/null || true
}

# Nazwy tymczasowe/atomowe pomijamy aż do zmiany nazwy (#33). Zapis przez plik tymczasowy i dopiero
# przemianowanie na nazwę docelową (rsync, zapis atomowy) inaczej trafiłoby do kolejki jako niekompletny
# plik tymczasowy. Po zmianie nazwy wpis pojawia się pod nazwą docelową i jest normalnie eksportowany.
is_temp() {
  case ${1##*/} in
    .* | *.tmp | *.part | *~) return 0 ;;
    *) return 1 ;;
  esac
}

# Przeniesienie nie unieważnia otwartych deskryptorów. Tylko nowa kopia na prywatnych
# i-węzłach może być podstawą przeglądu i decyzji (#20). Błędne/niepełne żądania
# zostają w .incoming.*, bez manifestu gotowego wniosku; operator bada je lokalnie.
# Wywołanie jest warunkiem w sweep: bash wyłącza wtedy errexit także wewnątrz
# funkcji. Każdy błąd przed usunięciem źródła musi być obsłużony jawnie.
queue_entry() {
  local path=$1 name owner uid ts incoming dest sha request_id
  name=${path##*/}
  ts=$(date -u +%Y%m%dT%H%M%SZ) || return 1
  # request_id PRZED mktemp: gdyby pobranie padło, nie zostaje sierota .incoming.* blokująca sweep.
  # /proc/sys/kernel/random/uuid zamiast forka python3 — bez zależności od PATH, praktycznie nie pada.
  request_id=$(cat /proc/sys/kernel/random/uuid) || return 1
  incoming=$(mktemp -d "$QUEUE/.incoming.XXXXXXXX") || return 1
  if ! mv -T -- "$path" "$incoming/source" 2>/dev/null; then
    # EXDEV może pozostawić częściową kopię: nigdy nie usuwaj jej automatycznie.
    if rmdir -- "$incoming" 2>/dev/null; then return 0; fi
    log "snapshot_failed request_id=$request_id reason=transfer_error"
    return 1
  fi
  owner=$(stat -c %U -- "$incoming/source") || return 1
  uid=$(stat -c %u -- "$incoming/source") || return 1
  if ! sha=$("$SNAPSHOT" create "$incoming/source" "$incoming/bundle" "$name" "$request_id"); then
    log "snapshot_failed request_id=$request_id reason=snapshot_error"
    reject_notice "$uid" "$name" snapshot_error
    return 1
  fi
  # Nazwa z badacza jest kodowana, żeby nie mogła wstrzyknąć pól/wierszy do logu.
  name=$(printf '%s' "$name" | LC_ALL=C tr -c 'a-zA-Z0-9._-' '_') || return 1
  name=${name:0:120}
  dest="$QUEUE/${ts}_${owner}_${name}"
  [[ -e $dest || -L $dest ]] && dest+=".$request_id"
  if ! mv -T -- "$incoming/bundle" "$dest"; then
    log "snapshot_failed request_id=$request_id reason=publish_error"
    return 1
  fi
  # Utrwalenie rename przed usunięciem źródła. Awaria zostawia gotowy wniosek
  # i/lub kwarantannę — nie publikuje nic poza WLB i nie ponawia automatycznie.
  if ! sync -f "$QUEUE"; then
    log "snapshot_failed request_id=$request_id reason=sync_error"
    return 1
  fi
  log "export_request user=$owner uid=$uid entry=$name sha256=$sha queued_as=${dest##*/}" || return 1
  rm -rf -- "$incoming"
}

sweep() {
  local entry newest
  # Nie ponawiaj przyjęć po przerwanym przejęciu/kopii. Źródło może nadal być
  # w /sluza-out (EXDEV/ENOSPC); ponawianie tworzyłoby kolejne częściowe kopie.
  for entry in "$QUEUE"/.incoming.*; do
    [[ -d $entry ]] && return 0
  done
  shopt -s nullglob dotglob
  for entry in "$SRC"/*; do
    # plik tymczasowy/atomowy — pomijamy do zmiany nazwy na docelową (#33)
    is_temp "$entry" && continue
    # wstępna selekcja; o dopuszczeniu wpisu decyduje queue_entry na kopii w kolejce
    if [[ -f $entry && ! -L $entry ]]; then
      # plik wciąż otwarty przez proces badacza — poczekaj na zamknięcie
      fuser -s -- "$entry" 2>/dev/null && continue
      queue_entry "$entry" || return 0
    elif [[ -d $entry && ! -L $entry ]]; then
      # badacz może w tym czasie usuwać pliki — błąd find nie może zatrzymać usługi
      newest=$(find -P "$entry" -printf '%T@\n' 2>/dev/null | sort -n | tail -1) || true
      [[ -n $newest ]] || continue
      if (($(date +%s) - ${newest%.*} >= DIR_SETTLE_SECONDS)); then queue_entry "$entry" || return 0; fi
    else
      # dowiązania i pliki specjalne nie są dopuszczone do eksportu (rm -f nie podąża za dowiązaniem;
      # jeśli wpis został w międzyczasie podmieniony na katalog, obsłuży go następny przegląd)
      log "rejected user=$(stat -c %U -- "$entry" 2>/dev/null || echo '?') entry=$(printf '%s' "${entry##*/}" | LC_ALL=C tr -c 'a-zA-Z0-9._-' '_') reason=unsupported_type"
      reject_notice "$(stat -c %u -- "$entry" 2>/dev/null || echo 0)" "${entry##*/}" unsupported_type
      rm -f -- "$entry" 2>/dev/null || true
    fi
  done
  shopt -u nullglob dotglob
}

mkdir -p "$QUEUE"
chmod 0700 "$QUEUE"
# Usługa i --once nie mogą jednocześnie publikować ani nadpisywać wniosków.
exec 9>"$QUEUE/.mover.lock"
flock -n 9 || exit 0

if [[ ${1:-} == --once ]]; then
  sweep
  exit 0
fi

log "start src=$SRC queue=$QUEUE"
while true; do
  sweep
  # budzi się po zamknięciu pliku, przeniesieniu lub utworzeniu wpisu, najpóźniej co 30 s (katalogi).
  # create: dowiązania, katalogi i pliki specjalne nie dają close_write — bez tego czekałyby do 30 s.
  # Plik tworzony do zapisu jest wtedy jeszcze otwarty (fuser), więc poczeka na close_write.
  inotifywait -q -t 30 -e close_write -e moved_to -e create "$SRC" >/dev/null 2>&1 || true
done
