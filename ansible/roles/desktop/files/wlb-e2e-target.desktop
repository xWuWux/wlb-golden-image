[Desktop Entry]
Version=1.0
Type=Application
Name=E2E Target Runner
GenericName=Autostart targetu E2E
Comment=Automatyczny start targetu E2E w sesji pulpitu XFCE (#277)
# Exec absolutny (#199): sesja XFCE nie ma /usr/local/bin w PATH
Exec=/opt/wlb/e2e/target-runner.sh
Icon=input-mouse
Terminal=false
StartupNotify=false
OnlyShowIn=XFCE;
