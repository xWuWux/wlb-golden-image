#!/usr/bin/env bash
# wlb-firstboot — konfiguracja per-Laboratorium przy pierwszym starcie VM z golden image.
#
# Wywoływany z cloud-init (runcmd), po zamontowaniu udziałów. Czyta /etc/wlb/lab.env
# i ustawia to, co zależy od Laboratorium: prawa katalogów, konta badaczy z dysku
# roboczego, proxy, reguły egress, przekazywanie logów do SIEM i administratora huba.
# Opis zmiennych: /etc/wlb/lab.env.example
#
#   wlb-firstboot           # jednorazowo (drugi raz nic nie robi)
#   wlb-firstboot --force   # ponownie, np. po zmianie lab.env (przed blokadą audytu)
#
# WLB_ROOT i WLB_* pozwalają uruchomić skrypt w piaskownicy (testy jednostkowe).
set -euo pipefail

R=${WLB_ROOT:-}
ENV_FILE=${WLB_ENV_FILE:-$R/etc/wlb/lab.env}
IMAGE_CONF=${WLB_IMAGE_CONF:-$R/etc/wlb/image.conf}
DIRS_CONF=$R/etc/wlb/directories.conf
STATE_DIR=$R/var/lib/wlb
DONE=$STATE_DIR/firstboot.done
HUB_CONFIG_D=$R/opt/tljh/config/jupyterhub_config.d
ADMIN_PASSWORD_FILE=$R/root/wlb-hub-admin-initial-password
TLJH_CONFIG=${WLB_TLJH_CONFIG:-/opt/tljh/hub/bin/tljh-config}
HUB_USER_TOOL=${WLB_HUB_USER_TOOL:-/usr/local/sbin/wlb-hub-user}
HUB_USER_RETRY_SLEEP=${WLB_HUB_USER_RETRY_SLEEP:-5} # pauza między próbami założenia konta huba (#31)
HUB_URL=${WLB_HUB_URL:-http://127.0.0.1}
HUB_WAIT_SECONDS=${WLB_HUB_WAIT_SECONDS:-180}
MEMINFO=${WLB_MEMINFO:-/proc/meminfo}

log() {
  logger -t wlb-firstboot -- "$*"
  echo "wlb-firstboot: $*"
}
die() {
  log "BŁĄD: $*"
  exit 1
}

[[ -r $ENV_FILE ]] || die "brak $ENV_FILE (powinien go zapisać cloud-init)"
if [[ -f $DONE && ${1:-} != --force ]]; then
  log "już wykonane $(cat "$DONE") — pomijam (użyj --force)"
  exit 0
fi

# shellcheck source=/dev/null
. "$IMAGE_CONF"
set -a
# shellcheck source=/dev/null
. "$ENV_FILE"
set +a
: "${LAB_NAME:?LAB_NAME jest wymagane w $ENV_FILE}"
: "${HUB_ADMIN_USER:?HUB_ADMIN_USER jest wymagane w $ENV_FILE}"
# Login walidujemy jak wlb-hub-user — poza poprawnością trafia też do pliku konfiguracji roli huba
# (15-wlb-admin-role.py, #51), więc bezpieczny zestaw znaków chroni przed wstrzyknięciem do Pythona.
[[ $HUB_ADMIN_USER =~ ^[a-z0-9][a-z0-9._-]{0,31}$ ]] ||
  die "HUB_ADMIN_USER ma nieprawidłowy format (login ^[a-z0-9][a-z0-9._-]{0,31}\$): '${HUB_ADMIN_USER}'"
PROXY_URL=${PROXY_URL:-}
NO_PROXY=${NO_PROXY:-localhost,127.0.0.1}
PYPI_INDEX_URL=${PYPI_INDEX_URL:-}
CRAN_MIRROR_URL=${CRAN_MIRROR_URL:-}
# Instalacja pakietów przez badacza (IMG-004, #23): deny = zakaz (§24.c, domyślnie),
# mirror = tylko z kuratorowanego mirrora Laboratorium. Brak przełącznika nie może
# rozstrzygać kwestii regulaminowej — dlatego domyślnie deny, a nie „mirror, gdy URL ustawiony”.
RESEARCHER_PACKAGE_INSTALL=${RESEARCHER_PACKAGE_INSTALL:-deny}
EGRESS_ALLOW=${EGRESS_ALLOW:-}
# Fail-secure (#18/IMG-005): wymagany jawny zakres źródłowy — brak domyślnego 0.0.0.0/0. Zakres jest
# walidowany jako pojedyncza kanoniczna sieć IPv4 (prefiks 1–32); listy, zakresy, dodatkowe tokeny,
# spacje, /0 i IPv6 są odrzucane PRZED modyfikacją zapory. To walidacja składni konfiguracji
# administratora platformy, nie twierdzenie, że badacz może edytować lab.env.
validate_cidr() { # $1=nazwa zmiennej $2=wartość
  local name=$1 val=$2 prefix o
  [[ $val =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})/([0-9]{1,2})$ ]] ||
    die "${name}='${val}' — oczekiwano pojedynczej sieci IPv4 w zapisie A.B.C.D/prefiks, bez list, spacji i IPv6 (#18)"
  for o in "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"; do
    ((10#$o <= 255)) || die "${name}='${val}' — oktet ${o} poza zakresem 0–255 (#18)"
  done
  prefix=${BASH_REMATCH[5]}
  ((10#$prefix >= 1 && 10#$prefix <= 32)) ||
    die "${name}='${val}' — prefiks musi być 1–32 (/0 otwierające cały internet i >32 są zabronione, #18)"
}
: "${ADMIN_SSH_CIDR:?ADMIN_SSH_CIDR jest wymagane (#18): zakres źródłowy SSH administratora platformy}"
: "${HUB_ALLOWED_CIDR:?HUB_ALLOWED_CIDR jest wymagane (#18): zakres źródłowy dostępu do huba}"
validate_cidr ADMIN_SSH_CIDR "$ADMIN_SSH_CIDR"
validate_cidr HUB_ALLOWED_CIDR "$HUB_ALLOWED_CIDR"
# TLS huba (#18/IMG-005, §20): domyślnie włączony. HUB_TLS=0 tylko świadomie (dev/izolowana sieć,
# z ostrzeżeniem). HUB_TLS=1 wymaga certyfikatu i klucza z cloud-init write_files (jak SIEM_CA_CERT) —
# traefik/TLJH słucha HTTPS na 443, a 80 przekierowuje. Wewnętrzne sprawdzenia huba idą wtedy po HTTPS.
HUB_TLS=${HUB_TLS:-1}
HUB_TLS_CERT=${HUB_TLS_CERT:-/etc/wlb/hub-tls.crt}
HUB_TLS_KEY=${HUB_TLS_KEY:-/etc/wlb/hub-tls.key}
[[ $HUB_TLS == 1 && -z ${WLB_HUB_URL:-} ]] && HUB_URL="https://127.0.0.1"
# -k tylko dla samokontroli po pętli lokalnej (127.0.0.1): cert huba ma SAN nazwy, nie IP pętli.
# Przy nadpisanym WLB_HUB_URL NIE wyłączamy weryfikacji — zaufanie i nazwę trzeba wtedy sprawdzić naprawdę.
HUB_CURL_K=()
[[ $HUB_TLS == 1 && -z ${WLB_HUB_URL:-} ]] && HUB_CURL_K=(-k)
# Fail-secure: pełna walidacja TLS (para klucz–cert, ważność, prawa, brak hasła) PRZED otwarciem zapory
# i uruchomieniem proxy — inaczej błędny TLS wystawiłby hub po jawnym tekście (§20, dane medyczne/RODO).
validate_hub_tls() { # waliduje HUB_TLS_CERT/KEY; wołane tylko dla HUB_TLS=1
  local cert=$R$HUB_TLS_CERT key=$R$HUB_TLS_KEY perm cpub kpub
  [[ -r $cert ]] || die "HUB_TLS=1: brak certyfikatu huba ${HUB_TLS_CERT} (cloud-init write_files)"
  [[ -r $key ]] || die "HUB_TLS=1: brak klucza huba ${HUB_TLS_KEY} (cloud-init write_files)"
  perm=$(stat -c '%a' "$key" 2>/dev/null || echo 777)
  (((8#$perm & 8#077) == 0)) || die "HUB_TLS=1: klucz ${HUB_TLS_KEY} ma zbyt szerokie prawa (${perm}) — wymagane maks. 0600 (#18)"
  openssl x509 -in "$cert" -noout >/dev/null 2>&1 || die "HUB_TLS=1: ${HUB_TLS_CERT} nie jest poprawnym certyfikatem PEM"
  openssl x509 -in "$cert" -checkend 0 -noout >/dev/null 2>&1 || die "HUB_TLS=1: certyfikat ${HUB_TLS_CERT} wygasł (#18)"
  # Klucz bez hasła: </dev/null sprawia, że chroniony klucz dostaje EOF zamiast promptu i daje błąd (nie zawisa).
  openssl pkey -in "$key" -noout </dev/null >/dev/null 2>&1 ||
    die "HUB_TLS=1: ${HUB_TLS_KEY} nie jest poprawnym kluczem PEM albo jest chroniony hasłem (firstboot jest nieinteraktywny, #18)"
  # Zgodność pary: klucz publiczny z certu == publiczny z klucza prywatnego (DER — działa dla RSA i ECDSA).
  cpub=$(openssl x509 -in "$cert" -noout -pubkey 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | openssl dgst -sha256 2>/dev/null) || true
  kpub=$(openssl pkey -in "$key" -pubout -outform DER </dev/null 2>/dev/null | openssl dgst -sha256 2>/dev/null) || true
  [[ -n $cpub && $cpub == "$kpub" ]] || die "HUB_TLS=1: certyfikat i klucz nie są parą (#18)"
}
case $HUB_TLS in
  1) validate_hub_tls ;;
  0) ;;
  *) die "HUB_TLS musi być 0 albo 1, jest '${HUB_TLS}'" ;;
esac
# Uwierzytelnianie: native (MVP, Native Authenticator) albo oidc (Entra ID / Keycloak przez OAuth). #18
AUTH_MODE=${AUTH_MODE:-native}
OIDC_CLIENT_ID=${OIDC_CLIENT_ID:-}
OIDC_CLIENT_SECRET=${OIDC_CLIENT_SECRET:-}
OIDC_AUTHORIZE_URL=${OIDC_AUTHORIZE_URL:-} # .../authorize
OIDC_TOKEN_URL=${OIDC_TOKEN_URL:-}         # .../token
OIDC_USERDATA_URL=${OIDC_USERDATA_URL:-}   # .../userinfo
OIDC_CALLBACK_URL=${OIDC_CALLBACK_URL:-}   # https://<portal>/hub/oauth_callback (wymaga HTTPS, #18)
OIDC_SCOPE=${OIDC_SCOPE:-openid email profile}
OIDC_USERNAME_CLAIM=${OIDC_USERNAME_CLAIM:-preferred_username} # claim -> login; musi dać jupyter-<login>
OIDC_GROUPS_CLAIM=${OIDC_GROUPS_CLAIM:-groups}
OIDC_ALLOWED_GROUPS=${OIDC_ALLOWED_GROUPS:-} # grupy IdP z dostępem do Laboratorium (oddzielone przecinkami)
OIDC_ADMIN_GROUPS=${OIDC_ADMIN_GROUPS:-}     # grupy IdP z rolą administratora huba
NTP_SERVERS=${NTP_SERVERS:-}
SIEM_HOST=${SIEM_HOST:-}
SIEM_PROTOCOL=${SIEM_PROTOCOL:-tcp}
# TLS do SIEM domyślnie włączony (§20); SIEM_TLS=0 tylko jawnie, z ostrzeżeniem w logu (#6)
SIEM_TLS=${SIEM_TLS:-1}
SIEM_TLS_NAME=${SIEM_TLS_NAME:-}                                         # nazwa (SAN/CN) w certyfikacie SIEM; domyślnie SIEM_HOST, gdy to nazwa DNS
SIEM_CA_CERT=${SIEM_CA_CERT:-/etc/wlb/siem-ca.pem}                       # CA, które wystawiło certyfikat SIEM (cloud-init write_files)
SIEM_PORT=${SIEM_PORT:-$([[ $SIEM_TLS == 1 ]] && echo 6514 || echo 514)} # 6514: syslog po TLS (RFC 5425)
LOCAL_TEST_MODE=${LOCAL_TEST_MODE:-0}
# limity zasobów badaczy (#30) — puste = wyliczane z RAM i vCPU VM
SYSTEM_MEM_RESERVE=${SYSTEM_MEM_RESERVE:-}  # rezerwa na usługi, np. 4G; domyślnie max(3G, 10% RAM)
RESEARCHERS_PER_VM=${RESEARCHERS_PER_VM:-1} # ilu badaczy równolegle na tej VM (IMG-001: domyślnie VM na badacza)
# Liczba bezosobowych kont stanowiskowych uNN pre-provisionowanych przy pierwszym starcie (IMG-002/#102);
# domyślnie tyle, ile równoległych badaczy. Konta u01..uNN + Administrator Klienta a01; mapowanie
# osoba↔konto trzyma rejestr (poza nazwą konta). 0 = brak kont badaczy (laboratorium tylko z adminem).
RESEARCHER_ACCOUNTS=${RESEARCHER_ACCOUNTS:-$RESEARCHERS_PER_VM}
if [[ ! $RESEARCHER_ACCOUNTS =~ ^[0-9]+$ ]] || ((RESEARCHER_ACCOUNTS > 64)); then
  die "RESEARCHER_ACCOUNTS musi być liczbą 0–64, jest '${RESEARCHER_ACCOUNTS}'"
fi
RESEARCHER_MEM_LIMIT=${RESEARCHER_MEM_LIMIT:-}     # pamięć na badacza, np. 8G; domyślnie pula / RESEARCHERS_PER_VM
RESEARCHER_CPU_LIMIT=${RESEARCHER_CPU_LIMIT:-}     # rdzenie na badacza, np. 2 albo 1.5; domyślnie vCPU / RESEARCHERS_PER_VM (min. 1)
RESEARCHER_TASKS_MAX=${RESEARCHER_TASKS_MAX:-2048} # procesy i wątki na badacza (ochrona przed fork bomb)
export PROXY_URL NO_PROXY LAB_NAME

mkdir -p "$STATE_DIR"
chmod 0700 "$STATE_DIR"

# --- 1. Katalogi §10 — udziały sieciowe mogły przykryć prawa z obrazu -----------
while read -r path owner group mode; do
  [[ -z $path || $path == \#* ]] && continue
  mkdir -p "$R$path"
  if ! { chown "$owner:$group" "$R$path" && chmod "$mode" "$R$path"; } 2>/dev/null; then
    log "uwaga: nie można ustawić praw $path (udział tylko do odczytu? prawa ustawia serwer)"
  fi
done <"$DIRS_CONF"

# Wspólny katalog projektu (§10, #50): domyślny ACL grupy rwX, żeby pliki utworzone przez jednego
# badacza (umask 0077) mogli edytować pozostali członkowie zespołu mimo setgid. Udział sieciowy mógł
# przykryć prawa — jak przy katalogach wyżej, log zamiast przerwania.
if [[ -d $R/projekt ]]; then
  setfacl -d -m g::rwX "$R/projekt" 2>/dev/null ||
    log "uwaga: nie można ustawić domyślnego ACL /projekt (udział tylko do odczytu? ACL ustawia serwer)"
fi

# Przy pierwszym starcie cloud-init montuje dysk roboczy i udziały dopiero w trakcie rozruchu —
# śluza wyjściowa mogła wystartować wcześniej i widzieć katalogi sprzed montowania
systemctl restart wlb-sluza-out.service

# --- 2. Konta badaczy z dysku roboczego ------------------------------------------
# Dysk systemowy jest jednorazowy, /workspace przechodzi na nową VM. Odtwarzamy konta
# systemowe z tym samym UID co właściciel katalogu domowego, zanim TLJH założy je od nowa
# z innym UID i badacz straci dostęp do własnych plików.
shopt -s nullglob
for home in "$R"/workspace/jupyter-*/; do
  home=${home%/}
  name=$(basename -- "$home")
  uid=$(stat -c %u -- "$home")
  gid=$(stat -c %g -- "$home") # grupa główna badacza (useradd nie zawsze daje GID = UID)
  getent passwd "$name" >/dev/null && continue
  if ((uid < WLB_RESEARCHER_UID_MIN || uid > WLB_RESEARCHER_UID_MAX)); then
    log "uwaga: $home należy do UID $uid spoza zakresu badaczy — pomijam"
    continue
  fi
  if getent passwd "$uid" >/dev/null; then
    log "uwaga: UID $uid ($home) jest zajęty przez inne konto — pomijam"
    continue
  fi
  if ! getent group "$name" >/dev/null; then
    if getent group "$gid" >/dev/null; then
      log "uwaga: GID $gid ($home) jest zajęty — grupa $name dostaje nowy GID"
      groupadd "$name"
    else
      groupadd -g "$gid" "$name"
    fi
  fi
  useradd -u "$uid" -g "$name" -G "$WLB_RESEARCHER_GROUP" -d "/workspace/$name" -M -s /bin/bash "$name"
  log "odtworzono konto $name (UID $uid) z dysku roboczego"
done
shopt -u nullglob

# --- 2a. Źródła czasu (znaczniki czasu audytu i logów, §21) --------------------------
NTP_CONF=$R/etc/chrony/sources.d/wlb.sources
mkdir -p "$(dirname "$NTP_CONF")"
if [[ -n $NTP_SERVERS ]]; then
  # walidacja przed zapisem: komunikat błędu nie może trafić do pliku, a plik nie może zostać połowiczny
  for s in $NTP_SERVERS; do
    # chrony nie rozumie zapisu host:port (port to osobna opcja) — wpis przeszedłby do pliku i zepsuł synchronizację
    [[ $s == *:* && $s != *:*:* ]] &&
      die "NTP_SERVERS: '$s' — zapis host:port nie jest obsługiwany (chrony używa portu 123)"
    if [[ $s == *:*:* ]]; then
      [[ $s =~ ^[0-9A-Fa-f:.]+$ ]] || die "nieprawidłowy serwer w NTP_SERVERS: '$s'" # IPv6 (także ::ffff:10.0.0.1)
    else
      # nazwa hosta lub IPv4: etykiety z liter, cyfr i łączników (nie na brzegach), rozdzielone kropkami
      [[ $s =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$ ]] ||
        die "nieprawidłowy serwer w NTP_SERVERS: '$s'"
    fi
  done
  {
    echo "# Wygenerowane przez wlb-firstboot (${LAB_NAME}) — nie edytować ręcznie."
    for s in $NTP_SERVERS; do echo "server $s iburst"; done
  } >"$NTP_CONF"
  if ! err=$(chronyc reload sources 2>&1); then
    log "chronyc reload sources nieudane (${err//$'\n'/ }) — restart usługi chrony"
    systemctl restart chrony
  fi
  log "NTP: $NTP_SERVERS"
else
  rm -f "$NTP_CONF"
  log "uwaga: NTP_SERVERS nie ustawione — brak synchronizacji czasu, znaczniki audytu mogą się rozjeżdżać"
fi

# --- 3. Proxy, mirrory i instalacja pakietów przez badacza (IMG-004, #23) ----------
# Uwaga o modelu zagrożeń: konfiguracja klienta (pip.conf, r-repos.R) NIE jest kontrolą —
# badacz może ją ominąć (pip --index-url, install.packages(repos=)). O możliwości instalacji
# decydują: osiągalność mirrora z UID badacza (nftables EGRESS_ALLOW + proxy, #16) i to, co
# mirror udostępnia (allowlista pakietów = zgoda Administratora IP_CMC z góry, IMG-004).
# Ten przełącznik sprawia, że obraz realizuje jawną decyzję zamiast wywnioskować ją z
# samej obecności PYPI_INDEX_URL.
case $RESEARCHER_PACKAGE_INSTALL in
  deny | mirror) ;;
  *) die "RESEARCHER_PACKAGE_INSTALL musi być deny albo mirror, jest '${RESEARCHER_PACKAGE_INSTALL}' (IMG-004)" ;;
esac
touch "$R/etc/environment"
sed -i '/^\(http_proxy\|https_proxy\|no_proxy\|HTTP_PROXY\|HTTPS_PROXY\|NO_PROXY\|PYTHONNOUSERSITE\)=/d' "$R/etc/environment"
if [[ -n $PROXY_URL ]]; then
  for v in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY; do echo "$v=$PROXY_URL"; done >>"$R/etc/environment"
  printf 'no_proxy=%s\nNO_PROXY=%s\n' "$NO_PROXY" "$NO_PROXY" >>"$R/etc/environment"
fi
mkdir -p "$R/etc/wlb"
case $RESEARCHER_PACKAGE_INSTALL in
  deny)
    # §24.c: brak zgody na instalacje po stronie badacza. Sprzątamy też po trybie mirror
    # (--force na żywym dysku roboczym), żeby zmiana decyzji nie zostawiała starej konfiguracji.
    rm -f "$R/etc/pip.conf"
    # Profil R z obrazu (rola r_env) wskazuje snapshot PPM z budowania; w trybie deny
    # usuwamy repozytoria, żeby install.packaged() kończyło się błędem bez sięgania do sieci,
    # a nie przez proxy do publicznego snapshotu.
    printf '# Wygenerowane przez wlb-firstboot (%s) — tryb deny (IMG-004): brak repozytoriów pakietów.\noptions(repos = character(0))\n' "$LAB_NAME" >"$R/etc/wlb/r-repos.R"
    # Pakiety zostawione w ~/.local na dysku roboczym (wcześniejszy tryb mirror, Upload) nie
    # mogą ładować się automatycznie — wynik analizy ma zależeć od obrazu, nie od tego katalogu.
    # (Odpowiednik dla biblioteki użytkownika R i depotu Julii nie jest tu obsługiwany — #23.)
    echo 'PYTHONNOUSERSITE=1' >>"$R/etc/environment"
    export PYTHONNOUSERSITE=1 # dla configu serwerów notebooków poniżej
    if [[ -n $PYPI_INDEX_URL || -n $CRAN_MIRROR_URL ]]; then
      log "ostrzeżenie: RESEARCHER_PACKAGE_INSTALL=deny, ale lab.env ustawia PYPI_INDEX_URL/CRAN_MIRROR_URL — mirrory będą zignorowane (#23)"
    fi
    # porównanie best-effort: zapis host:port z PROXY_URL kontra wpisy EGRESS_ALLOW (bez resolvera)
    proxy_hostport=${PROXY_URL#*://}
    proxy_hostport=${proxy_hostport#*@}
    proxy_hostport=${proxy_hostport%%/*}
    if [[ -n $proxy_hostport && " $EGRESS_ALLOW " == *" $proxy_hostport "* ]]; then
      log "ostrzeżenie: tryb deny, ale proxy pozostaje w EGRESS_ALLOW — instalacja jest technicznie możliwa (pip --index-url); zablokuj mirrory na proxy albo usuń proxy z allowlisty (#16)"
    fi
    ;;
  mirror)
    # Allowlista pakietów na mirrorze = zgoda z góry (IMG-004). Nie wolno zostawić pustego
    # adresu mirrora: pip zostałby na publicznym PyPI, a R na snapshotcie PPM z budowania,
    # czyli instalowałyby się poza allowlistą Administratora.
    [[ -n $PYPI_INDEX_URL ]] || die "RESEARCHER_PACKAGE_INSTALL=mirror wymaga kuratorowanego PYPI_INDEX_URL (IMG-004)"
    [[ -n $CRAN_MIRROR_URL ]] || die "RESEARCHER_PACKAGE_INSTALL=mirror wymaga kuratorowanego CRAN_MIRROR_URL (IMG-004)"
    printf '# wlb-firstboot (%s)\n[global]\nindex-url = %s\n' "$LAB_NAME" "$PYPI_INDEX_URL" >"$R/etc/pip.conf"
    printf '# wlb-firstboot (%s)\noptions(repos = c(CRAN = "%s"))\n' "$LAB_NAME" "$CRAN_MIRROR_URL" >"$R/etc/wlb/r-repos.R"
    [[ -n $PROXY_URL || -n $EGRESS_ALLOW ]] ||
      log "uwaga: tryb mirror, ale brak PROXY_URL i EGRESS_ALLOW — instalacje badacza zatrzyma zapora egress (#16)"
    ;;
esac

# Zasady dla badacza w /docs muszą zgadzać się z trybem (statyczny /docs/README.md opisuje
# je neutralnie). /docs w produkcji bywa przykryty udziałem sieciowym — log zamiast przerwania.
mkdir -p "$R/docs"
{
  echo "# Instalacja pakietów — Laboratorium ${LAB_NAME}"
  echo
  echo "_Wygenerowane przez wlb-firstboot — decyzja IMG-004, tryb \`${RESEARCHER_PACKAGE_INSTALL}\`._"
  echo
  if [[ $RESEARCHER_PACKAGE_INSTALL == deny ]]; then
    cat <<'MD'
Tryb: **zakaz** (§24.c Regulaminu).

- Nie instaluj pakietów (`pip install`, `install.packaged()`, `Pkg.add()`) — wymaga to
  uprzedniej zgody Administratora IP_CMC.
- Potrzebujesz pakietu: złóż wniosek do Administratora IP_CMC (§29.5); trafi do kolejnej
  wersji obrazu.
- Pakiety pozostawione w katalogu domowym (`~/.local`) nie są ładowane do sesji Pythona
