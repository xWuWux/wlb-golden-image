#!/usr/bin/env bash
# wlb-firstboot — konfiguracja per-Laboratorium przy pierwszym starcie VM z golden image.
#
# Wywoływany z cloud-init (runcmd), po zamontowaniu udziałów. Czyta /etc/wlb/lab.env
# i ustawia to, co zależy od Laboratorium: prawa katalogów, konta badaczy z dysku
# roboczego, proxy, reguły egress, przekazywanie logów do SIEM i administratora huba.
# Opis zmiennych: /etc/wlb/lab.env.example
#
#   wlb-firstboot           # jednorazowo (drugi raz nic nie robi)
#   wlb-firstboot --force   # ponownie, np. po zmianie lab.env (przed blokadą audytu)
#
# WLB_ROOT i WLB_* pozwalają uruchomić skrypt w piaskownicy (testy jednostkowe).
set -euo pipefail

R=${WLB_ROOT:-}
ENV_FILE=${WLB_ENV_FILE:-$R/etc/wlb/lab.env}
IMAGE_CONF=${WLB_IMAGE_CONF:-$R/etc/wlb/image.conf}
DIRS_CONF=$R/etc/wlb/directories.conf
STATE_DIR=$R/var/lib/wlb
DONE=$STATE_DIR/firstboot.done
HUB_CONFIG_D=$R/opt/tljh/config/jupyterhub_config.d
ADMIN_PASSWORD_FILE=$R/root/wlb-hub-admin-initial-password
TLJH_CONFIG=${WLB_TLJH_CONFIG:-/opt/tljh/hub/bin/tljh-config}
HUB_USER_TOOL=${WLB_HUB_USER_TOOL:-/usr/local/sbin/wlb-hub-user}
HUB_URL=${WLB_HUB_URL:-http://127.0.0.1}
HUB_WAIT_SECONDS=${WLB_HUB_WAIT_SECONDS:-180}

log() {
  logger -t wlb-firstboot -- "$*"
  echo "wlb-firstboot: $*"
}
die() {
  log "BŁĄD: $*"
  exit 1
}

[[ -r $ENV_FILE ]] || die "brak $ENV_FILE (powinien go zapisać cloud-init)"
if [[ -f $DONE && ${1:-} != --force ]]; then
  log "już wykonane $(cat "$DONE") — pomijam (użyj --force)"
  exit 0
fi

# shellcheck source=/dev/null
. "$IMAGE_CONF"
set -a
# shellcheck source=/dev/null
. "$ENV_FILE"
set +a
: "${LAB_NAME:?LAB_NAME jest wymagane w $ENV_FILE}"
: "${HUB_ADMIN_USER:?HUB_ADMIN_USER jest wymagane w $ENV_FILE}"
PROXY_URL=${PROXY_URL:-}
NO_PROXY=${NO_PROXY:-localhost,127.0.0.1}
PYPI_INDEX_URL=${PYPI_INDEX_URL:-}
CRAN_MIRROR_URL=${CRAN_MIRROR_URL:-}
EGRESS_ALLOW=${EGRESS_ALLOW:-}
ADMIN_SSH_CIDR=${ADMIN_SSH_CIDR:-0.0.0.0/0}
HUB_ALLOWED_CIDR=${HUB_ALLOWED_CIDR:-0.0.0.0/0}
NTP_SERVERS=${NTP_SERVERS:-}
SIEM_HOST=${SIEM_HOST:-}
SIEM_PROTOCOL=${SIEM_PROTOCOL:-tcp}
# TLS do SIEM domyślnie włączony (§20); SIEM_TLS=0 tylko jawnie, z ostrzeżeniem w logu (#6)
SIEM_TLS=${SIEM_TLS:-1}
SIEM_TLS_NAME=${SIEM_TLS_NAME:-}                                         # nazwa (SAN/CN) w certyfikacie SIEM; domyślnie SIEM_HOST, gdy to nazwa DNS
SIEM_CA_CERT=${SIEM_CA_CERT:-/etc/wlb/siem-ca.pem}                       # CA, które wystawiło certyfikat SIEM (cloud-init write_files)
SIEM_PORT=${SIEM_PORT:-$([[ $SIEM_TLS == 1 ]] && echo 6514 || echo 514)} # 6514: syslog po TLS (RFC 5425)
LOCAL_TEST_MODE=${LOCAL_TEST_MODE:-0}
export PROXY_URL NO_PROXY LAB_NAME

mkdir -p "$STATE_DIR"
chmod 0700 "$STATE_DIR"

# --- 1. Katalogi §10 — udziały sieciowe mogły przykryć prawa z obrazu -----------
while read -r path owner group mode; do
  [[ -z $path || $path == \#* ]] && continue
  mkdir -p "$R$path"
  if ! { chown "$owner:$group" "$R$path" && chmod "$mode" "$R$path"; } 2>/dev/null; then
    log "uwaga: nie można ustawić praw $path (udział tylko do odczytu? prawa ustawia serwer)"
  fi
done <"$DIRS_CONF"

# Przy pierwszym starcie cloud-init montuje dysk roboczy i udziały dopiero w trakcie rozruchu —
# śluza wyjściowa mogła wystartować wcześniej i widzieć katalogi sprzed montowania
systemctl restart wlb-sluza-out.service

# --- 2. Konta badaczy z dysku roboczego ------------------------------------------
# Dysk systemowy jest jednorazowy, /workspace przechodzi na nową VM. Odtwarzamy konta
# systemowe z tym samym UID co właściciel katalogu domowego, zanim TLJH założy je od nowa
# z innym UID i badacz straci dostęp do własnych plików.
shopt -s nullglob
for home in "$R"/workspace/jupyter-*/; do
  home=${home%/}
  name=$(basename -- "$home")
  uid=$(stat -c %u -- "$home")
  gid=$(stat -c %g -- "$home") # grupa główna badacza (useradd nie zawsze daje GID = UID)
  getent passwd "$name" >/dev/null && continue
  if ((uid < WLB_RESEARCHER_UID_MIN || uid > WLB_RESEARCHER_UID_MAX)); then
    log "uwaga: $home należy do UID $uid spoza zakresu badaczy — pomijam"
    continue
  fi
  if getent passwd "$uid" >/dev/null; then
    log "uwaga: UID $uid ($home) jest zajęty przez inne konto — pomijam"
    continue
  fi
  if ! getent group "$name" >/dev/null; then
    if getent group "$gid" >/dev/null; then
      log "uwaga: GID $gid ($home) jest zajęty — grupa $name dostaje nowy GID"
      groupadd "$name"
    else
      groupadd -g "$gid" "$name"
    fi
  fi
  useradd -u "$uid" -g "$name" -G "$WLB_RESEARCHER_GROUP" -d "/workspace/$name" -M -s /bin/bash "$name"
  log "odtworzono konto $name (UID $uid) z dysku roboczego"
done
shopt -u nullglob

# --- 2a. Źródła czasu (znaczniki czasu audytu i logów, §21) --------------------------
NTP_CONF=$R/etc/chrony/sources.d/wlb.sources
mkdir -p "$(dirname "$NTP_CONF")"
if [[ -n $NTP_SERVERS ]]; then
  # walidacja przed zapisem: komunikat błędu nie może trafić do pliku, a plik nie może zostać połowiczny
  for s in $NTP_SERVERS; do
    # chrony nie rozumie zapisu host:port (port to osobna opcja) — wpis przeszedłby do pliku i zepsuł synchronizację
    [[ $s == *:* && $s != *:*:* ]] &&
      die "NTP_SERVERS: '$s' — zapis host:port nie jest obsługiwany (chrony używa portu 123)"
    if [[ $s == *:*:* ]]; then
      [[ $s =~ ^[0-9A-Fa-f:.]+$ ]] || die "nieprawidłowy serwer w NTP_SERVERS: '$s'" # IPv6 (także ::ffff:10.0.0.1)
    else
      # nazwa hosta lub IPv4: etykiety z liter, cyfr i łączników (nie na brzegach), rozdzielone kropkami
      [[ $s =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$ ]] ||
        die "nieprawidłowy serwer w NTP_SERVERS: '$s'"
    fi
  done
  {
    echo "# Wygenerowane przez wlb-firstboot (${LAB_NAME}) — nie edytować ręcznie."
    for s in $NTP_SERVERS; do echo "server $s iburst"; done
  } >"$NTP_CONF"
  if ! err=$(chronyc reload sources 2>&1); then
    log "chronyc reload sources nieudane (${err//$'\n'/ }) — restart usługi chrony"
    systemctl restart chrony
  fi
  log "NTP: $NTP_SERVERS"
else
  rm -f "$NTP_CONF"
  log "uwaga: NTP_SERVERS nie ustawione — brak synchronizacji czasu, znaczniki audytu mogą się rozjeżdżać"
fi

# --- 3. Proxy i mirrory pakietów --------------------------------------------------
touch "$R/etc/environment"
sed -i '/^\(http_proxy\|https_proxy\|no_proxy\|HTTP_PROXY\|HTTPS_PROXY\|NO_PROXY\)=/d' "$R/etc/environment"
if [[ -n $PROXY_URL ]]; then
  for v in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY; do echo "$v=$PROXY_URL"; done >>"$R/etc/environment"
  printf 'no_proxy=%s\nNO_PROXY=%s\n' "$NO_PROXY" "$NO_PROXY" >>"$R/etc/environment"
fi
if [[ -n $PYPI_INDEX_URL ]]; then
  printf '# wlb-firstboot (%s)\n[global]\nindex-url = %s\n' "$LAB_NAME" "$PYPI_INDEX_URL" >"$R/etc/pip.conf"
fi
if [[ -n $CRAN_MIRROR_URL ]]; then
  printf '# wlb-firstboot (%s)\noptions(repos = c(CRAN = "%s"))\n' "$LAB_NAME" "$CRAN_MIRROR_URL" >"$R/etc/wlb/r-repos.R"
fi

# Serwery notebooków startuje systemd, więc /etc/environment ich nie dotyczy
mkdir -p "$HUB_CONFIG_D"
python3 - >"$HUB_CONFIG_D/50-wlb-lab.py" <<'PY'
import json, os
env = {"WLB_LAB_NAME": os.environ["LAB_NAME"]}
if os.environ["PROXY_URL"]:
    for k in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY"):
        env[k] = os.environ["PROXY_URL"]
    env["no_proxy"] = env["NO_PROXY"] = os.environ["NO_PROXY"]
print("# Wygenerowane przez wlb-firstboot — nie edytować ręcznie.")
print("c = get_config()  # noqa: F821")
print(f"c.Spawner.environment = {json.dumps(env, indent=4)}")
PY

# --- 4. Zapora: ruch wychodzący badaczy tylko do allowlisty -----------------------
# Obrona w głębi. Właściwą izolację Laboratorium zapewnia sieć (SDN/Neutron) i proxy.
allow_rules=""
for entry in $EGRESS_ALLOW; do
  addr=${entry%:*}
  port=${entry##*:}
  [[ -n $addr && $port =~ ^[0-9]+$ && $addr != "$entry" ]] ||
    die "nieprawidłowy wpis EGRESS_ALLOW: '$entry' (oczekiwano ADRES_IPv4[/maska]:PORT)"
  allow_rules+="        ip daddr $addr tcp dport $port accept"$'\n'
done

cat >"$R/etc/nftables.conf" <<EOF
#!/usr/sbin/nft -f
# Wygenerowane przez wlb-firstboot dla Laboratorium ${LAB_NAME} — nie edytować ręcznie.
flush ruleset

table inet wlb {
    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop
        meta l4proto { icmp, ipv6-icmp } accept
        udp dport { 68, 546 } accept
        ip saddr ${ADMIN_SSH_CIDR} tcp dport 22 accept
        ip saddr ${HUB_ALLOWED_CIDR} tcp dport { 80, 443 } accept
        limit rate 5/second log prefix "wlb-in-deny " level info
    }

    chain output {
        type filter hook output priority filter; policy accept;
        oif "lo" accept
        ct state established,related accept
        meta skuid ${WLB_RESEARCHER_UID_MIN}-${WLB_RESEARCHER_UID_MAX} jump researcher_egress
    }

    chain researcher_egress {
${allow_rules}        limit rate 5/second log prefix "wlb-egress-deny " level info
        reject with icmpx type admin-prohibited
    }
}
EOF
nft -c -f "$R/etc/nftables.conf" || die "błędne reguły nftables (sprawdź EGRESS_ALLOW i *_CIDR)"
systemctl restart nftables

# --- 5. Przekazywanie logów do centralnego SIEM (§21) ------------------------------
SIEM_CONF=$R/etc/rsyslog.d/60-wlb-siem.conf
if [[ -n $SIEM_HOST ]]; then
  # Logi zawierają polecenia badaczy, loginy i nazwy eksportów — domyślnie tylko po TLS z weryfikacją
  # nazwy serwera (x509/name: certyfikat z tego samego CA wystawiony na inną nazwę jest odrzucany).
  # Fail-secure: bez modułu TLS, poprawnego CA lub nazwy serwera konfiguracja się nie kończy, zamiast
  # po cichu wysyłać otwartym tekstem. rsyslogd -N1 nie wykrywa braku modułu ani pliku CA.
  case $SIEM_TLS in
    1)
      [[ $SIEM_PROTOCOL == tcp ]] || die "SIEM_TLS=1 wymaga SIEM_PROTOCOL=tcp (TLS nie działa po UDP)"
      if [[ -z $SIEM_TLS_NAME ]]; then
        [[ $SIEM_HOST == *:* || $SIEM_HOST =~ ^[0-9.]+$ ]] &&
          die "SIEM_HOST=${SIEM_HOST} to adres IP — ustaw SIEM_TLS_NAME (nazwa z certyfikatu SIEM)"
        SIEM_TLS_NAME=$SIEM_HOST
      fi
      [[ $SIEM_TLS_NAME =~ ^[A-Za-z0-9*]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] ||
        die "nieprawidłowe SIEM_TLS_NAME: '${SIEM_TLS_NAME}'"
      compgen -G "$R/usr/lib/*/rsyslog/lmnsd_gtls.so" >/dev/null ||
        die "brak modułu TLS rsyslog (lmnsd_gtls.so, pakiet rsyslog-gnutls)"
      # profil AppArmor rsyslogd (rola logging) pozwala czytać tylko /etc/wlb/*.pem — inny plik root
      # przeczyta (sprawdzenie niżej przejdzie), ale rsyslog już nie i logi zostaną tylko w kolejce
      [[ $SIEM_CA_CERT =~ ^/etc/wlb/[A-Za-z0-9._-]+\.pem$ ]] ||
        die "SIEM_CA_CERT=${SIEM_CA_CERT}: certyfikat CA musi leżeć w /etc/wlb/*.pem (AppArmor rsyslogd)"
      [[ -r $R$SIEM_CA_CERT ]] || die "SIEM_TLS=1: brak certyfikatu CA SIEM ${SIEM_CA_CERT} (cloud-init write_files)"
      openssl x509 -noout -in "$R$SIEM_CA_CERT" 2>/dev/null ||
        die "SIEM_TLS=1: ${SIEM_CA_CERT} nie jest poprawnym certyfikatem PEM"
      siem_tls="StreamDriver=\"gtls\" StreamDriverMode=\"1\" StreamDriverAuthMode=\"x509/name\"
           StreamDriverPermittedPeers=\"${SIEM_TLS_NAME}\" streamDriver.CAFile=\"${SIEM_CA_CERT}\""
      siem_desc="TLS, serwer ${SIEM_TLS_NAME}"
      ;;
    0)
      siem_tls=""
      siem_desc="BEZ TLS"
      log "uwaga: SIEM_TLS=0 — logi (polecenia badaczy, loginy, eksporty) idą do SIEM otwartym tekstem; tylko na jawną decyzję administratora (§20)"
      ;;
    *) die "SIEM_TLS musi być 0 albo 1, jest '${SIEM_TLS}'" ;;
  esac
  mkdir -p "$(dirname "$SIEM_CONF")"
  cat >"$SIEM_CONF" <<EOF
# Wygenerowane przez wlb-firstboot (${LAB_NAME}). Kolejka dyskowa — logi nie giną, gdy SIEM jest niedostępny.
# RFC 5424 z polami zaufanymi [wlb@32473 ...]: źródło w rsyslog (imuxsock/imklog) oraz uid/gid/pid
# nadawcy z jądra — SIEM rozpoznaje po nich zdarzenia podrobione przez badacza (#44).
template(name="WLB_SyslogProtocol23Trusted" type="string"
         string="<%PRI%>1 %TIMESTAMP:::date-rfc3339% %HOSTNAME% %APP-NAME% %PROCID% %MSGID% [wlb@32473 input=\"%inputname%\" uid=\"%\$!uid%\" gid=\"%\$!gid%\" pid=\"%\$!pid%\"] %msg%\n")
*.* action(type="omfwd" target="${SIEM_HOST}" port="${SIEM_PORT}" protocol="${SIEM_PROTOCOL}"
           ${siem_tls}
           template="WLB_SyslogProtocol23Trusted"
           queue.type="LinkedList" queue.filename="wlb_siem" queue.maxDiskSpace="2g"
           queue.saveOnShutdown="on" action.resumeRetryCount="-1")
EOF
  rsyslogd -N1 >/dev/null || die "błędna konfiguracja rsyslog"
  log "logi przekazywane do ${SIEM_HOST}:${SIEM_PORT}/${SIEM_PROTOCOL} (${siem_desc})"
else
  rm -f "$SIEM_CONF"
  log "uwaga: SIEM_HOST nie ustawiony — logi tylko lokalnie"
fi
systemctl restart rsyslog

# --- 6. JupyterHub: administrator Klienta Środowiska WLB -----------------------------
[[ ${WLB_TLJH_ADMIN_SUDO:-0} == 1 ]] || rm -f "$R/etc/sudoers.d/jupyterhub-admins"
if ! "$TLJH_CONFIG" show | grep -qE "^\s*-\s*${HUB_ADMIN_USER}\s*$"; then
  "$TLJH_CONFIG" add-item users.admin "$HUB_ADMIN_USER"
fi
"$TLJH_CONFIG" reload hub
hub_ready() { curl -sf -o /dev/null "$HUB_URL/hub/api"; }
for ((waited = 0; waited < HUB_WAIT_SECONDS; waited += 2)); do
  hub_ready && break
  sleep 2
done
hub_ready || die "JupyterHub nie odpowiada"

# Baza huba leży na dysku roboczym: po wymianie dysku systemowego konto już istnieje
# i jego hasło zostaje bez zmian.
if [[ ! -s $ADMIN_PASSWORD_FILE ]]; then
  password=$("$HUB_USER_TOOL" --if-missing "$HUB_ADMIN_USER")
  if [[ -n $password ]]; then
    mkdir -p "$(dirname "$ADMIN_PASSWORD_FILE")"
    (
      umask 077
      printf '%s\n' "$password" >"$ADMIN_PASSWORD_FILE"
    )
    log "konto huba ${HUB_ADMIN_USER} utworzone; hasło początkowe: ${ADMIN_PASSWORD_FILE#"$R"}"
  else
    log "konto huba ${HUB_ADMIN_USER} już istnieje (dysk roboczy) — hasło bez zmian"
  fi
fi

# --- 7. Dane przykładowe (wyłącznie lokalny test obrazu) ------------------------------
if [[ $LOCAL_TEST_MODE == 1 ]]; then
  printf 'person_id,year_of_birth,gender_concept_id\n1,1970,8507\n2,1985,8532\n' >"$R/data-mart/wlb-test-cohort.csv"
  echo "plik testowy śluzy wejściowej" >"$R/sluza-in/wlb-test-input.txt"
  chown root:"$WLB_RESEARCHER_GROUP" "$R/data-mart/wlb-test-cohort.csv" "$R/sluza-in/wlb-test-input.txt"
  chmod 0640 "$R/data-mart/wlb-test-cohort.csv" "$R/sluza-in/wlb-test-input.txt"
  log "tryb testu lokalnego: zasiano dane przykładowe"
fi

# --- 8. Koniec: reguły audytu po montowaniach, potem blokada ---------------------------
date -Is >"$DONE"
systemctl start wlb-audit-rules.service
log "Laboratorium ${LAB_NAME} skonfigurowane"
