#!/usr/bin/env bash
# wlb-firstboot — konfiguracja per-Laboratorium przy pierwszym starcie VM z golden image.
#
# Wywoływany z cloud-init (runcmd), po zamontowaniu udziałów. Czyta /etc/wlb/lab.env
# i ustawia to, co zależy od Laboratorium: prawa katalogów, konta badaczy z dysku
# roboczego, proxy, reguły egress, przekazywanie logów do SIEM i administratora huba.
# Opis zmiennych: /etc/wlb/lab.env.example
#
#   wlb-firstboot           # jednorazowo (drugi raz nic nie robi)
#   wlb-firstboot --force   # ponownie, np. po zmianie lab.env (przed blokadą audytu)
#
# WLB_ROOT i WLB_* pozwalają uruchomić skrypt w piaskownicy (testy jednostkowe).
set -euo pipefail

R=${WLB_ROOT:-}
ENV_FILE=${WLB_ENV_FILE:-$R/etc/wlb/lab.env}
IMAGE_CONF=${WLB_IMAGE_CONF:-$R/etc/wlb/image.conf}
DIRS_CONF=$R/etc/wlb/directories.conf
STATE_DIR=$R/var/lib/wlb
DONE=$STATE_DIR/firstboot.done
HUB_CONFIG_D=$R/opt/tljh/config/jupyterhub_config.d
ADMIN_PASSWORD_FILE=$R/root/wlb-hub-admin-initial-password
TLJH_CONFIG=${WLB_TLJH_CONFIG:-/opt/tljh/hub/bin/tljh-config}
HUB_USER_TOOL=${WLB_HUB_USER_TOOL:-/usr/local/sbin/wlb-hub-user}
HUB_USER_RETRY_SLEEP=${WLB_HUB_USER_RETRY_SLEEP:-5} # pauza między próbami założenia konta huba (#31)
HUB_URL=${WLB_HUB_URL:-http://127.0.0.1}
HUB_WAIT_SECONDS=${WLB_HUB_WAIT_SECONDS:-180}
MEMINFO=${WLB_MEMINFO:-/proc/meminfo}

log() {
  logger -t wlb-firstboot -- "$*"
  echo "wlb-firstboot: $*"
}
die() {
  log "BŁĄD: $*"
  exit 1
}

[[ -r $ENV_FILE ]] || die "brak $ENV_FILE (powinien go zapisać cloud-init)"
if [[ -f $DONE && ${1:-} != --force ]]; then
  log "już wykonane $(cat "$DONE") — pomijam (użyj --force)"
  exit 0
fi

# shellcheck source=/dev/null
. "$IMAGE_CONF"
set -a
# shellcheck source=/dev/null
. "$ENV_FILE"
set +a
: "${LAB_NAME:?LAB_NAME jest wymagane w $ENV_FILE}"
: "${HUB_ADMIN_USER:?HUB_ADMIN_USER jest wymagane w $ENV_FILE}"
PROXY_URL=${PROXY_URL:-}
NO_PROXY=${NO_PROXY:-localhost,127.0.0.1}
PYPI_INDEX_URL=${PYPI_INDEX_URL:-}
CRAN_MIRROR_URL=${CRAN_MIRROR_URL:-}
EGRESS_ALLOW=${EGRESS_ALLOW:-}
# Fail-secure (#18/IMG-005): wymagany jawny zakres źródłowy — brak domyślnego 0.0.0.0/0, a jawne
# 0.0.0.0/0 jest odrzucane. SSH administratora i dostęp do huba nie są otwierane z całego internetu.
: "${ADMIN_SSH_CIDR:?ADMIN_SSH_CIDR jest wymagane (#18): zakres źródłowy SSH administratora platformy}"
: "${HUB_ALLOWED_CIDR:?HUB_ALLOWED_CIDR jest wymagane (#18): zakres źródłowy dostępu do huba}"
[[ $ADMIN_SSH_CIDR == 0.0.0.0/0 ]] && die "ADMIN_SSH_CIDR=0.0.0.0/0 zabronione (#18) — podaj realny zakres sieci"
[[ $HUB_ALLOWED_CIDR == 0.0.0.0/0 ]] && die "HUB_ALLOWED_CIDR=0.0.0.0/0 zabronione (#18) — podaj realny zakres sieci"
# TLS huba (#18/IMG-005, §20): domyślnie włączony. HUB_TLS=0 tylko świadomie (dev/izolowana sieć,
# z ostrzeżeniem). HUB_TLS=1 wymaga certyfikatu i klucza z cloud-init write_files (jak SIEM_CA_CERT) —
# traefik/TLJH słucha HTTPS na 443, a 80 przekierowuje. Wewnętrzne sprawdzenia huba idą wtedy po HTTPS.
HUB_TLS=${HUB_TLS:-1}
HUB_TLS_CERT=${HUB_TLS_CERT:-/etc/wlb/hub-tls.crt}
HUB_TLS_KEY=${HUB_TLS_KEY:-/etc/wlb/hub-tls.key}
[[ $HUB_TLS == 1 && -z ${WLB_HUB_URL:-} ]] && HUB_URL="https://127.0.0.1"
HUB_CURL_K=() # przy TLS: self-signed/wewnętrzne CA na pętli lokalnej akceptujemy (-k)
[[ $HUB_TLS == 1 ]] && HUB_CURL_K=(-k)
# Uwierzytelnianie: native (MVP, Native Authenticator) albo oidc (Entra ID / Keycloak przez OAuth). #18
AUTH_MODE=${AUTH_MODE:-native}
OIDC_CLIENT_ID=${OIDC_CLIENT_ID:-}
OIDC_CLIENT_SECRET=${OIDC_CLIENT_SECRET:-}
OIDC_AUTHORIZE_URL=${OIDC_AUTHORIZE_URL:-} # .../authorize
OIDC_TOKEN_URL=${OIDC_TOKEN_URL:-}         # .../token
OIDC_USERDATA_URL=${OIDC_USERDATA_URL:-}   # .../userinfo
OIDC_CALLBACK_URL=${OIDC_CALLBACK_URL:-}   # https://<portal>/hub/oauth_callback (wymaga HTTPS, #18)
OIDC_SCOPE=${OIDC_SCOPE:-openid email profile}
OIDC_USERNAME_CLAIM=${OIDC_USERNAME_CLAIM:-preferred_username} # claim -> login; musi dać jupyter-<login>
OIDC_GROUPS_CLAIM=${OIDC_GROUPS_CLAIM:-groups}
OIDC_ALLOWED_GROUPS=${OIDC_ALLOWED_GROUPS:-} # grupy IdP z dostępem do Laboratorium (oddzielone przecinkami)
OIDC_ADMIN_GROUPS=${OIDC_ADMIN_GROUPS:-}     # grupy IdP z rolą administratora huba
NTP_SERVERS=${NTP_SERVERS:-}
SIEM_HOST=${SIEM_HOST:-}
SIEM_PROTOCOL=${SIEM_PROTOCOL:-tcp}
# TLS do SIEM domyślnie włączony (§20); SIEM_TLS=0 tylko jawnie, z ostrzeżeniem w logu (#6)
SIEM_TLS=${SIEM_TLS:-1}
SIEM_TLS_NAME=${SIEM_TLS_NAME:-}                                         # nazwa (SAN/CN) w certyfikacie SIEM; domyślnie SIEM_HOST, gdy to nazwa DNS
SIEM_CA_CERT=${SIEM_CA_CERT:-/etc/wlb/siem-ca.pem}                       # CA, które wystawiło certyfikat SIEM (cloud-init write_files)
SIEM_PORT=${SIEM_PORT:-$([[ $SIEM_TLS == 1 ]] && echo 6514 || echo 514)} # 6514: syslog po TLS (RFC 5425)
LOCAL_TEST_MODE=${LOCAL_TEST_MODE:-0}
# limity zasobów badaczy (#30) — puste = wyliczane z RAM i vCPU VM
SYSTEM_MEM_RESERVE=${SYSTEM_MEM_RESERVE:-}         # rezerwa na usługi, np. 4G; domyślnie max(3G, 10% RAM)
RESEARCHERS_PER_VM=${RESEARCHERS_PER_VM:-1}        # ilu badaczy równolegle na tej VM (IMG-001: domyślnie VM na badacza)
RESEARCHER_MEM_LIMIT=${RESEARCHER_MEM_LIMIT:-}     # pamięć na badacza, np. 8G; domyślnie pula / RESEARCHERS_PER_VM
RESEARCHER_CPU_LIMIT=${RESEARCHER_CPU_LIMIT:-}     # rdzenie na badacza, np. 2 albo 1.5; domyślnie vCPU / RESEARCHERS_PER_VM (min. 1)
RESEARCHER_TASKS_MAX=${RESEARCHER_TASKS_MAX:-2048} # procesy i wątki na badacza (ochrona przed fork bomb)
export PROXY_URL NO_PROXY LAB_NAME

mkdir -p "$STATE_DIR"
chmod 0700 "$STATE_DIR"

# --- 1. Katalogi §10 — udziały sieciowe mogły przykryć prawa z obrazu -----------
while read -r path owner group mode; do
  [[ -z $path || $path == \#* ]] && continue
  mkdir -p "$R$path"
  if ! { chown "$owner:$group" "$R$path" && chmod "$mode" "$R$path"; } 2>/dev/null; then
    log "uwaga: nie można ustawić praw $path (udział tylko do odczytu? prawa ustawia serwer)"
  fi
done <"$DIRS_CONF"

# Wspólny katalog projektu (§10, #50): domyślny ACL grupy rwX, żeby pliki utworzone przez jednego
# badacza (umask 0077) mogli edytować pozostali członkowie zespołu mimo setgid. Udział sieciowy mógł
# przykryć prawa — jak przy katalogach wyżej, log zamiast przerwania.
if [[ -d $R/projekt ]]; then
  setfacl -d -m g::rwX "$R/projekt" 2>/dev/null ||
    log "uwaga: nie można ustawić domyślnego ACL /projekt (udział tylko do odczytu? ACL ustawia serwer)"
fi

# Przy pierwszym starcie cloud-init montuje dysk roboczy i udziały dopiero w trakcie rozruchu —
# śluza wyjściowa mogła wystartować wcześniej i widzieć katalogi sprzed montowania
systemctl restart wlb-sluza-out.service

# --- 2. Konta badaczy z dysku roboczego ------------------------------------------
# Dysk systemowy jest jednorazowy, /workspace przechodzi na nową VM. Odtwarzamy konta
# systemowe z tym samym UID co właściciel katalogu domowego, zanim TLJH założy je od nowa
# z innym UID i badacz straci dostęp do własnych plików.
shopt -s nullglob
for home in "$R"/workspace/jupyter-*/; do
  home=${home%/}
  name=$(basename -- "$home")
  uid=$(stat -c %u -- "$home")
  gid=$(stat -c %g -- "$home") # grupa główna badacza (useradd nie zawsze daje GID = UID)
  getent passwd "$name" >/dev/null && continue
  if ((uid < WLB_RESEARCHER_UID_MIN || uid > WLB_RESEARCHER_UID_MAX)); then
    log "uwaga: $home należy do UID $uid spoza zakresu badaczy — pomijam"
    continue
  fi
  if getent passwd "$uid" >/dev/null; then
    log "uwaga: UID $uid ($home) jest zajęty przez inne konto — pomijam"
    continue
  fi
  if ! getent group "$name" >/dev/null; then
    if getent group "$gid" >/dev/null; then
      log "uwaga: GID $gid ($home) jest zajęty — grupa $name dostaje nowy GID"
      groupadd "$name"
    else
      groupadd -g "$gid" "$name"
    fi
  fi
  useradd -u "$uid" -g "$name" -G "$WLB_RESEARCHER_GROUP" -d "/workspace/$name" -M -s /bin/bash "$name"
  log "odtworzono konto $name (UID $uid) z dysku roboczego"
done
shopt -u nullglob

# --- 2a. Źródła czasu (znaczniki czasu audytu i logów, §21) --------------------------
NTP_CONF=$R/etc/chrony/sources.d/wlb.sources
mkdir -p "$(dirname "$NTP_CONF")"
if [[ -n $NTP_SERVERS ]]; then
  # walidacja przed zapisem: komunikat błędu nie może trafić do pliku, a plik nie może zostać połowiczny
  for s in $NTP_SERVERS; do
    # chrony nie rozumie zapisu host:port (port to osobna opcja) — wpis przeszedłby do pliku i zepsuł synchronizację
    [[ $s == *:* && $s != *:*:* ]] &&
      die "NTP_SERVERS: '$s' — zapis host:port nie jest obsługiwany (chrony używa portu 123)"
    if [[ $s == *:*:* ]]; then
      [[ $s =~ ^[0-9A-Fa-f:.]+$ ]] || die "nieprawidłowy serwer w NTP_SERVERS: '$s'" # IPv6 (także ::ffff:10.0.0.1)
    else
      # nazwa hosta lub IPv4: etykiety z liter, cyfr i łączników (nie na brzegach), rozdzielone kropkami
      [[ $s =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$ ]] ||
        die "nieprawidłowy serwer w NTP_SERVERS: '$s'"
    fi
  done
  {
    echo "# Wygenerowane przez wlb-firstboot (${LAB_NAME}) — nie edytować ręcznie."
    for s in $NTP_SERVERS; do echo "server $s iburst"; done
  } >"$NTP_CONF"
  if ! err=$(chronyc reload sources 2>&1); then
    log "chronyc reload sources nieudane (${err//$'\n'/ }) — restart usługi chrony"
    systemctl restart chrony
  fi
  log "NTP: $NTP_SERVERS"
else
  rm -f "$NTP_CONF"
  log "uwaga: NTP_SERVERS nie ustawione — brak synchronizacji czasu, znaczniki audytu mogą się rozjeżdżać"
fi

# --- 3. Proxy i mirrory pakietów --------------------------------------------------
touch "$R/etc/environment"
sed -i '/^\(http_proxy\|https_proxy\|no_proxy\|HTTP_PROXY\|HTTPS_PROXY\|NO_PROXY\)=/d' "$R/etc/environment"
if [[ -n $PROXY_URL ]]; then
  for v in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY; do echo "$v=$PROXY_URL"; done >>"$R/etc/environment"
  printf 'no_proxy=%s\nNO_PROXY=%s\n' "$NO_PROXY" "$NO_PROXY" >>"$R/etc/environment"
fi
if [[ -n $PYPI_INDEX_URL ]]; then
  printf '# wlb-firstboot (%s)\n[global]\nindex-url = %s\n' "$LAB_NAME" "$PYPI_INDEX_URL" >"$R/etc/pip.conf"
fi
if [[ -n $CRAN_MIRROR_URL ]]; then
  printf '# wlb-firstboot (%s)\noptions(repos = c(CRAN = "%s"))\n' "$LAB_NAME" "$CRAN_MIRROR_URL" >"$R/etc/wlb/r-repos.R"
fi

# Serwery notebooków startuje systemd, więc /etc/environment ich nie dotyczy
mkdir -p "$HUB_CONFIG_D"
python3 - >"$HUB_CONFIG_D/50-wlb-lab.py" <<'PY'
import json, os
env = {"WLB_LAB_NAME": os.environ["LAB_NAME"]}
if os.environ["PROXY_URL"]:
    for k in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY"):
        env[k] = os.environ["PROXY_URL"]
    env["no_proxy"] = env["NO_PROXY"] = os.environ["NO_PROXY"]
print("# Wygenerowane przez wlb-firstboot — nie edytować ręcznie.")
print("c = get_config()  # noqa: F821")
print(f"c.Spawner.environment = {json.dumps(env, indent=4)}")
PY

# --- 4. Zapora: ruch wychodzący badaczy tylko do allowlisty -----------------------
# Obrona w głębi. Właściwą izolację Laboratorium zapewnia sieć (SDN/Neutron) i proxy.
allow_rules=""
for entry in $EGRESS_ALLOW; do
  addr=${entry%:*}
  port=${entry##*:}
  [[ -n $addr && $port =~ ^[0-9]+$ && $addr != "$entry" ]] ||
    die "nieprawidłowy wpis EGRESS_ALLOW: '$entry' (oczekiwano ADRES_IPv4[/maska]:PORT)"
  allow_rules+="        ip daddr $addr tcp dport $port accept"$'\n'
done

# Porty huba (#18): przy TLS otwieramy 80 (przekierowanie traefika) i 443; bez TLS tylko 80.
hub_dports=$([[ $HUB_TLS == 1 ]] && echo '{ 80, 443 }' || echo '80')
cat >"$R/etc/nftables.conf" <<EOF
#!/usr/sbin/nft -f
# Wygenerowane przez wlb-firstboot dla Laboratorium ${LAB_NAME} — nie edytować ręcznie.
flush ruleset

table inet wlb {
    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop
        meta l4proto { icmp, ipv6-icmp } accept
        udp dport { 68, 546 } accept
        ip saddr ${ADMIN_SSH_CIDR} tcp dport 22 accept
        ip saddr ${HUB_ALLOWED_CIDR} tcp dport ${hub_dports} accept
        limit rate 5/second log prefix "wlb-in-deny " level info
    }

    chain output {
        type filter hook output priority filter; policy accept;
        oif "lo" accept
        ct state established,related accept
        meta skuid ${WLB_RESEARCHER_UID_MIN}-${WLB_RESEARCHER_UID_MAX} jump researcher_egress
    }

    chain researcher_egress {
${allow_rules}        limit rate 5/second log prefix "wlb-egress-deny " level info
        reject with icmpx type admin-prohibited
    }
}
EOF
nft -c -f "$R/etc/nftables.conf" || die "błędne reguły nftables (sprawdź EGRESS_ALLOW i *_CIDR)"
systemctl restart nftables

# --- 5. Przekazywanie logów do centralnego SIEM (§21) ------------------------------
SIEM_CONF=$R/etc/rsyslog.d/60-wlb-siem.conf
if [[ -n $SIEM_HOST ]]; then
  # Logi zawierają polecenia badaczy, loginy i nazwy eksportów — domyślnie tylko po TLS z weryfikacją
  # nazwy serwera (x509/name: certyfikat z tego samego CA wystawiony na inną nazwę jest odrzucany).
  # Fail-secure: bez modułu TLS, poprawnego CA lub nazwy serwera konfiguracja się nie kończy, zamiast
  # po cichu wysyłać otwartym tekstem. rsyslogd -N1 nie wykrywa braku modułu ani pliku CA.
  case $SIEM_TLS in
    1)
      [[ $SIEM_PROTOCOL == tcp ]] || die "SIEM_TLS=1 wymaga SIEM_PROTOCOL=tcp (TLS nie działa po UDP)"
      if [[ -z $SIEM_TLS_NAME ]]; then
        [[ $SIEM_HOST == *:* || $SIEM_HOST =~ ^[0-9.]+$ ]] &&
          die "SIEM_HOST=${SIEM_HOST} to adres IP — ustaw SIEM_TLS_NAME (nazwa z certyfikatu SIEM)"
        SIEM_TLS_NAME=$SIEM_HOST
      fi
      [[ $SIEM_TLS_NAME =~ ^[A-Za-z0-9*]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] ||
        die "nieprawidłowe SIEM_TLS_NAME: '${SIEM_TLS_NAME}'"
      compgen -G "$R/usr/lib/*/rsyslog/lmnsd_gtls.so" >/dev/null ||
        die "brak modułu TLS rsyslog (lmnsd_gtls.so, pakiet rsyslog-gnutls)"
      # profil AppArmor rsyslogd (rola logging) pozwala czytać tylko /etc/wlb/*.pem — inny plik root
      # przeczyta (sprawdzenie niżej przejdzie), ale rsyslog już nie i logi zostaną tylko w kolejce
      [[ $SIEM_CA_CERT =~ ^/etc/wlb/[A-Za-z0-9._-]+\.pem$ ]] ||
        die "SIEM_CA_CERT=${SIEM_CA_CERT}: certyfikat CA musi leżeć w /etc/wlb/*.pem (AppArmor rsyslogd)"
      [[ -r $R$SIEM_CA_CERT ]] || die "SIEM_TLS=1: brak certyfikatu CA SIEM ${SIEM_CA_CERT} (cloud-init write_files)"
      openssl x509 -noout -in "$R$SIEM_CA_CERT" 2>/dev/null ||
        die "SIEM_TLS=1: ${SIEM_CA_CERT} nie jest poprawnym certyfikatem PEM"
      siem_tls="StreamDriver=\"gtls\" StreamDriverMode=\"1\" StreamDriverAuthMode=\"x509/name\"
           StreamDriverPermittedPeers=\"${SIEM_TLS_NAME}\" streamDriver.CAFile=\"${SIEM_CA_CERT}\""
      siem_desc="TLS, serwer ${SIEM_TLS_NAME}"
      ;;
    0)
      siem_tls=""
      siem_desc="BEZ TLS"
      log "uwaga: SIEM_TLS=0 — logi (polecenia badaczy, loginy, eksporty) idą do SIEM otwartym tekstem; tylko na jawną decyzję administratora (§20)"
      ;;
    *) die "SIEM_TLS musi być 0 albo 1, jest '${SIEM_TLS}'" ;;
  esac
  mkdir -p "$(dirname "$SIEM_CONF")"
  cat >"$SIEM_CONF" <<EOF
# Wygenerowane przez wlb-firstboot (${LAB_NAME}). Kolejka dyskowa — logi nie giną, gdy SIEM jest niedostępny.
# RFC 5424 z polami zaufanymi [wlb@32473 ...]: źródło w rsyslog (imuxsock/imklog) oraz uid/gid/pid
# nadawcy z jądra — SIEM rozpoznaje po nich zdarzenia podrobione przez badacza (#44).
template(name="WLB_SyslogProtocol23Trusted" type="string"
         string="<%PRI%>1 %TIMESTAMP:::date-rfc3339% %HOSTNAME% %APP-NAME% %PROCID% %MSGID% [wlb@32473 input=\"%inputname%\" uid=\"%\$!uid%\" gid=\"%\$!gid%\" pid=\"%\$!pid%\"] %msg%\n")
*.* action(type="omfwd" target="${SIEM_HOST}" port="${SIEM_PORT}" protocol="${SIEM_PROTOCOL}"
           ${siem_tls}
           template="WLB_SyslogProtocol23Trusted"
           queue.type="LinkedList" queue.filename="wlb_siem" queue.maxDiskSpace="2g"
           queue.saveOnShutdown="on" action.resumeRetryCount="-1")
EOF
  rsyslogd -N1 >/dev/null || die "błędna konfiguracja rsyslog"
  log "logi przekazywane do ${SIEM_HOST}:${SIEM_PORT}/${SIEM_PROTOCOL} (${siem_desc})"
else
  rm -f "$SIEM_CONF"
  log "uwaga: SIEM_HOST nie ustawiony — logi tylko lokalnie"
fi
systemctl restart rsyslog

# --- 5a. Limity zasobów badaczy (#30) --------------------------------------------------------
# Jeden badacz nie może zająć całej VM: serwery notebooków są w wlb-badacze.slice z limitem
# pamięci (RAM minus rezerwa na audyt, logi, hub i SSH), a każdy ma własny limit pamięci, CPU
# i liczby procesów. OOMPolicy=continue: przy przekroczeniu limitu ginie proces (zwykle kernel),
# a nie cały serwer badacza — domyślne "stop" zatrzymywało całą sesję.
to_mib() { # 8G, 8192M, 8192 (MiB) -> MiB
  # wywoływane w $(...): komunikat na stderr, bo stdout to wynik
  [[ $2 =~ ^([0-9]+)([MmGg]?)$ ]] || { log "BŁĄD: $1: nieprawidłowy rozmiar '$2' (np. 8G albo 8192M)" >&2 && exit 1; }
  case ${BASH_REMATCH[2]} in
    [Gg]) echo $((BASH_REMATCH[1] * 1024)) ;;
    *) echo "${BASH_REMATCH[1]}" ;;
  esac
}
mem_total=$(($(awk '/^MemTotal:/ {print $2}' "$MEMINFO") / 1024))
cpus=$(nproc)
if [[ -n $SYSTEM_MEM_RESERVE ]]; then
  reserve=$(to_mib SYSTEM_MEM_RESERVE "$SYSTEM_MEM_RESERVE")
else
  reserve=$((mem_total / 10 > 3072 ? mem_total / 10 : 3072))
fi
pool=$((mem_total - reserve))
((pool >= 1024)) || die "za mało pamięci dla badaczy: ${mem_total} MiB RAM, rezerwa ${reserve} MiB (SYSTEM_MEM_RESERVE)"
if [[ ! $RESEARCHERS_PER_VM =~ ^[0-9]+$ ]] || ((RESEARCHERS_PER_VM < 1 || RESEARCHERS_PER_VM > 64)); then
  die "RESEARCHERS_PER_VM musi być liczbą 1–64, jest '${RESEARCHERS_PER_VM}'"
fi
if [[ -n $RESEARCHER_MEM_LIMIT ]]; then
  mem_limit=$(to_mib RESEARCHER_MEM_LIMIT "$RESEARCHER_MEM_LIMIT")
  ((mem_limit <= pool)) || die "RESEARCHER_MEM_LIMIT=${RESEARCHER_MEM_LIMIT} większe niż pula badaczy (${pool} MiB)"
else
  mem_limit=$((pool / RESEARCHERS_PER_VM))
fi
if [[ -n $RESEARCHER_CPU_LIMIT ]]; then
  [[ $RESEARCHER_CPU_LIMIT =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "nieprawidłowe RESEARCHER_CPU_LIMIT: '${RESEARCHER_CPU_LIMIT}'"
  cpu_limit=$RESEARCHER_CPU_LIMIT
else
  cpu_limit=$((cpus / RESEARCHERS_PER_VM > 1 ? cpus / RESEARCHERS_PER_VM : 1))
fi
if [[ ! $RESEARCHER_TASKS_MAX =~ ^[0-9]+$ ]] || ((RESEARCHER_TASKS_MAX < 64)); then
  die "RESEARCHER_TASKS_MAX musi być liczbą >= 64, jest '${RESEARCHER_TASKS_MAX}'"
fi
mkdir -p "$R/etc/systemd/system/wlb-badacze.slice.d" "$HUB_CONFIG_D"
cat >"$R/etc/systemd/system/wlb-badacze.slice.d/50-wlb-limits.conf" <<EOF
# Wygenerowane przez wlb-firstboot (${LAB_NAME}): RAM ${mem_total} MiB, rezerwa ${reserve} MiB.
[Slice]
MemoryMax=${pool}M
EOF
cat >"$HUB_CONFIG_D/60-wlb-limits.py" <<EOF
# Wygenerowane przez wlb-firstboot (${LAB_NAME}) — limity zasobów na badacza (#30).
c = get_config()  # noqa: F821
c.SystemdSpawner.mem_limit = "${mem_limit}M"
c.SystemdSpawner.cpu_limit = float("${cpu_limit}")
c.SystemdSpawner.unit_extra_properties = {
    "TasksMax": "${RESEARCHER_TASKS_MAX}",
    "OOMScoreAdjust": "500",  # przy braku pamięci w VM najpierw procesy badaczy, nie usługi
    "OOMPolicy": "continue",  # przekroczenie limitu zabija proces, nie cały serwer notebooków
}
EOF
systemctl daemon-reload
log "limity: RAM ${mem_total} MiB, rezerwa ${reserve} MiB, badacze razem ${pool} MiB (${RESEARCHERS_PER_VM} równolegle); na badacza ${mem_limit} MiB, CPU ${cpu_limit}, procesy ${RESEARCHER_TASKS_MAX}"

# --- 5c. Uwierzytelnianie: native (MVP) albo OIDC (Entra ID / Keycloak), #18 -----------------
# Domyślnie Native Authenticator (konta lokalne w bazie huba). AUTH_MODE=oidc przełącza na
# GenericOAuthenticator: logowanie webowe SSO, MFA po stronie IdP, hub bez haseł. Nadpisuje
# authenticator_class z config.yaml, bo plik 70 ładuje się po nim. Fail-secure: brak wymaganej
# zmiennej przerywa konfigurację, zamiast po cichu wrócić do logowania lokalnego.
AUTH_CONF=$HUB_CONFIG_D/70-wlb-auth.py
mkdir -p "$HUB_CONFIG_D"
case $AUTH_MODE in
  native)
    rm -f "$AUTH_CONF"
    log "uwierzytelnianie: native (Native Authenticator)"
    ;;
  oidc)
    for v in OIDC_CLIENT_ID OIDC_CLIENT_SECRET OIDC_AUTHORIZE_URL OIDC_TOKEN_URL OIDC_USERDATA_URL OIDC_CALLBACK_URL; do
      [[ -n ${!v} ]] || die "AUTH_MODE=oidc: brak wymaganej zmiennej ${v}"
    done
    for u in "$OIDC_AUTHORIZE_URL" "$OIDC_TOKEN_URL" "$OIDC_USERDATA_URL"; do
      [[ $u == https://* ]] || die "AUTH_MODE=oidc: punkty końcowe OIDC muszą być https (${u})"
    done
    [[ $OIDC_CALLBACK_URL == https://* ]] || die "AUTH_MODE=oidc: OIDC_CALLBACK_URL musi być https (#18)"
    # zmienne z wartościami domyślnymi są przypisane po `set +a`, więc eksportujemy je do python3 jawnie
    export OIDC_CLIENT_ID OIDC_CLIENT_SECRET OIDC_AUTHORIZE_URL OIDC_TOKEN_URL OIDC_USERDATA_URL \
      OIDC_CALLBACK_URL OIDC_SCOPE OIDC_USERNAME_CLAIM OIDC_GROUPS_CLAIM OIDC_ALLOWED_GROUPS OIDC_ADMIN_GROUPS
    python3 - >"$AUTH_CONF" <<'PY'
import os
def groups(name):
    return sorted({g for g in (x.strip() for x in os.environ.get(name, "").split(",")) if g})
print("# Wygenerowane przez wlb-firstboot — nie edytować ręcznie. Uwierzytelnianie OIDC (#18).")
print("c = get_config()  # noqa: F821")
print("c.JupyterHub.authenticator_class = 'generic-oauth'")
print(f"c.GenericOAuthenticator.client_id = {os.environ['OIDC_CLIENT_ID']!r}")
print(f"c.GenericOAuthenticator.client_secret = {os.environ['OIDC_CLIENT_SECRET']!r}")
print(f"c.GenericOAuthenticator.authorize_url = {os.environ['OIDC_AUTHORIZE_URL']!r}")
print(f"c.GenericOAuthenticator.token_url = {os.environ['OIDC_TOKEN_URL']!r}")
print(f"c.GenericOAuthenticator.userdata_url = {os.environ['OIDC_USERDATA_URL']!r}")
print(f"c.GenericOAuthenticator.oauth_callback_url = {os.environ['OIDC_CALLBACK_URL']!r}")
print(f"c.GenericOAuthenticator.scope = {os.environ['OIDC_SCOPE'].split()!r}")
print(f"c.GenericOAuthenticator.username_claim = {os.environ['OIDC_USERNAME_CLAIM']!r}")
print(f"c.GenericOAuthenticator.claim_groups_key = {os.environ['OIDC_GROUPS_CLAIM']!r}")
allowed, admin = groups("OIDC_ALLOWED_GROUPS"), groups("OIDC_ADMIN_GROUPS")
if allowed:
    # posortowana lista (deterministycznie); allowed_groups i tak traktuje ją jak zbiór
    print(f"c.GenericOAuthenticator.allowed_groups = {allowed!r}")
else:
    # brak grup: każdy uwierzytelniony w IdP ma dostęp — do zawężenia grupami (#18)
    print("c.GenericOAuthenticator.allow_all = True")
if admin:
    print(f"c.GenericOAuthenticator.admin_groups = {admin!r}")
PY
    chmod 0600 "$AUTH_CONF" # zawiera client_secret
    log "uwierzytelnianie: OIDC (${OIDC_AUTHORIZE_URL})"
    ;;
  *)
    die "AUTH_MODE musi być native albo oidc, jest '${AUTH_MODE}'"
    ;;
esac

# --- 6. JupyterHub: administrator Klienta Środowiska WLB -----------------------------
[[ ${WLB_TLJH_ADMIN_SUDO:-0} == 1 ]] || rm -f "$R/etc/sudoers.d/jupyterhub-admins"
if ! "$TLJH_CONFIG" show | grep -qE "^\s*-\s*${HUB_ADMIN_USER}\s*$"; then
  "$TLJH_CONFIG" add-item users.admin "$HUB_ADMIN_USER"
fi
# TLS huba (#18/IMG-005): fail-secure — HUB_TLS=1 wymaga poprawnego certu i klucza (jak SIEM TLS),
# inaczej firstboot się nie kończy, zamiast wystawić hub po jawnym tekście (§20).
case $HUB_TLS in
  1)
    [[ -r $R$HUB_TLS_CERT ]] || die "HUB_TLS=1: brak certyfikatu huba ${HUB_TLS_CERT} (cloud-init write_files)"
    [[ -r $R$HUB_TLS_KEY ]] || die "HUB_TLS=1: brak klucza huba ${HUB_TLS_KEY} (cloud-init write_files)"
    openssl x509 -in "$R$HUB_TLS_CERT" -noout >/dev/null 2>&1 ||
      die "HUB_TLS=1: ${HUB_TLS_CERT} nie jest poprawnym certyfikatem PEM"
    openssl pkey -in "$R$HUB_TLS_KEY" -noout >/dev/null 2>&1 ||
      die "HUB_TLS=1: ${HUB_TLS_KEY} nie jest poprawnym kluczem PEM"
    "$TLJH_CONFIG" set https.enabled true
    "$TLJH_CONFIG" set https.tls.cert "$HUB_TLS_CERT"
    "$TLJH_CONFIG" set https.tls.key "$HUB_TLS_KEY"
    log "TLS huba włączony: HTTPS na 443 (cert ${HUB_TLS_CERT})"
    ;;
  0)
    "$TLJH_CONFIG" set https.enabled false
    log "OSTRZEŻENIE: HUB_TLS=0 — hub po HTTP bez szyfrowania (§20). Dozwolone tylko w dev/izolowanej sieci."
    ;;
  *)
    die "HUB_TLS musi być 0 albo 1, jest '${HUB_TLS}'"
    ;;
esac
"$TLJH_CONFIG" reload proxy
"$TLJH_CONFIG" reload hub
hub_ready() { curl -sf "${HUB_CURL_K[@]}" -o /dev/null "$HUB_URL/hub/api"; }
for ((waited = 0; waited < HUB_WAIT_SECONDS; waited += 2)); do
  hub_ready && break
  sleep 2
done
hub_ready || die "JupyterHub nie odpowiada"

# Baza huba leży na dysku roboczym: po wymianie dysku systemowego konto już istnieje
# i jego hasło zostaje bez zmian.
if [[ ! -s $ADMIN_PASSWORD_FILE ]]; then
  # Ponawiamy: przy działającym hubie baza bywa chwilowo zablokowana (#31). Bez tego błąd
  # przerwałby firstboot po cichu (set -e) — nie powstałby firstboot.done, więc reguły audytu
  # nie zostałyby zablokowane. Narzędzie samo czeka na blokadę (LOCK_TIMEOUT); tu łapiemy resztę.
  created=0 password=""
  for attempt in 1 2 3; do
    if password=$("$HUB_USER_TOOL" --if-missing "$HUB_ADMIN_USER"); then
      created=1
      break
    fi
    log "konto huba ${HUB_ADMIN_USER}: próba ${attempt}/3 nieudana (baza huba zajęta?) — ponawiam"
    sleep "$HUB_USER_RETRY_SLEEP"
  done
  ((created == 1)) || die "nie udało się założyć konta huba ${HUB_ADMIN_USER} po 3 próbach (baza zajęta?)"
  if [[ -n $password ]]; then
    mkdir -p "$(dirname "$ADMIN_PASSWORD_FILE")"
    (
      umask 077
      printf '%s\n' "$password" >"$ADMIN_PASSWORD_FILE"
    )
    log "konto huba ${HUB_ADMIN_USER} utworzone; hasło początkowe: ${ADMIN_PASSWORD_FILE#"$R"}"
  else
    log "konto huba ${HUB_ADMIN_USER} już istnieje (dysk roboczy) — hasło bez zmian"
  fi
fi

