# Zarządzane przez Ansible (rola tljh). Zmiany wprowadzamy w repozytorium, nie na żywej VM.
# users.admin ZOSTAJE PUSTE: Administrator Klienta dostaje rolę OGRANICZONĄ (bez access:servers/tokens),
# a nie pełnego admina (IMG-003/#51). Rolę nadaje wlb-firstboot w 15-wlb-admin-role.py na podstawie
# HUB_ADMIN_USER z /etc/wlb/lab.env; audyt akcji admina: 16-wlb-admin-audit.py.
auth:
  type: nativeauthenticator.NativeAuthenticator

users:
  admin: []

user_environment:
  default_app: jupyterlab

services:
  cull:
    enabled: true
    timeout: {{ tljh_idle_timeout_seconds }}   # bezczynność
    every: {{ tljh_cull_every_seconds }}
    max_age: {{ tljh_max_session_seconds }}   # §9.5: zatrzymanie po 12 h niezależnie od aktywności
    users: false
