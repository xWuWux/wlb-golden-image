# Zarządzane przez Ansible (rola tljh) — hooki cyklu życia sesji badacza (#97) + rekord użycia (#98).
# Korelacja "jedna sesja badacza" dla SIEM (§21): pre_spawn emituje session_start, post_stop —
# session_stop z czasem trwania. Emisja przez /opt/wlb/bin/wlb-session-log (root → pola zaufne
# imuxsock/uid=0, #44). Po stopie dodatkowo rekord użycia/pojemności (#98) przez wlb-usage-record.
#
# Stan sesji przeżywa RESTART HUBA (nie reboot maszyny): atrybuty spawnera istnieją tylko w
# pamięci procesu huba, więc start/stop korylowany jest plikiem /run/wlb/usage/sessions/<unit>.json.
# Osierocony plik (hub przeładował sie w srodku sesji) zostaje domkniety statusem "interrupted"
# przy nastepnym spawnie tej samej jednostki — zamiast znikac bez sladu albo udawac czas "0".
# Lab bierzemy ze Spawner.environment (WLB_LAB_NAME pisany przez wlb-firstboot) — to sciezka
# gwarantowana; zmienna srodowiska procesu huba jest tylko rezerwa i to jest odnotowane w rekordzie.
# Hook woła wyłącznie lokalne zapisy (bez sieci), z krotkim timeoutem; awaria raportowania nie moze
# zablokowac spawna/stopu — logujemy niezerowy kod wyjscia (limitowany komunikat, #98).
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import time
import uuid

c = get_config()  # noqa: F821

_WLB_SESSION_LOG = "/opt/wlb/bin/wlb-session-log"
_WLB_USAGE_RECORD = "/opt/wlb/bin/wlb-usage-record"
_WLB_STATE_DIR = os.environ.get("WLB_USAGE_STATE_DIR", "/run/wlb/usage/sessions")
_WLB_TIMEOUT_S = 2  # tylko lokalny zapis — dluzszy czas oznacza awarie, nie prace

# Sprzatanie scratcha sesji (#318). HOME badacza to /workspace na TRWALYM dysku roboczym,
# wiec nie wolno tam niczego czyscic rekurencyjnie. Scratch zyje na tmpfs (/run) i jest
# usuwany w calosci po stopie; artefakty display-scoped tylko dla zwalnianego uid/DISPLAY.
_WLB_SCRATCH_ROOT = os.environ.get("WLB_SCRATCH_ROOT", "/run/wlb/scratch")
_WLB_TMP_ROOT = os.environ.get("WLB_TMP_ROOT", "/tmp")
_WLB_XAUTHORITY = os.environ.get("WLB_XAUTHORITY", "/workspace/.Xauthority")
_WLB_DENY_PREFIX = "/workspace"
_WLB_UID_MIN = 10000  # zgodne z wlb_researcher_uid_min/max (ansible/group_vars/all.yml)
_WLB_UID_MAX = 59999
_WLB_CLEAN_TIMEOUT_S = 2  # krotki timeout lokalnego xauth; sprzatanie nie moze blokowac stopu


def _wlb_lab(spawner):
    env = getattr(spawner, "environment", None) or {}
    lab = env.get("WLB_LAB_NAME") or os.environ.get("LAB_NAME", "")
    source = "spawner_env" if env.get("WLB_LAB_NAME") else ("hub_env" if lab else "missing")
    return lab, source


def _wlb_ident(spawner):
    user = "jupyter-" + spawner.user.name
    unit = getattr(spawner, "unit_name", None) or (user + ".service")
    try:
        uid = str(pwd.getpwnam(user).pw_uid)
    except KeyError:
        uid = ""
    sid = getattr(spawner, "_wlb_session", "")
    return user, uid, unit, sid


def _wlb_state_path(unit):
    safe = unit.replace("/", "_").replace("..", "_")  # defensywnie: unit nie powinien zawierac ścieżek
    return _WLB_STATE_DIR + "/" + safe + ".json"


def _wlb_run(spawner, args, what):
    try:
        rc = subprocess.run(args, check=False, timeout=_WLB_TIMEOUT_S).returncode
    except Exception as exc:  # noqa: BLE001 — hook nie moze wywrócic spawnu/stopu
        spawner.log.warning("wlb-session: %s nie wykonano (%s): %s", what, args[0], exc)
        return
    if rc != 0:
        spawner.log.warning("wlb-session: %s zakonczylo sie kodym %s", what, rc)


def _wlb_write_state(spawner, unit, state):
    # raportowanie nie moze zablokowac sesji — awaria pliku stanu to ostrzeżenie, nie wyjatek
    try:
        os.makedirs(_WLB_STATE_DIR, exist_ok=True)
        tmp = _wlb_state_path(unit) + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(state, fh)
        os.replace(tmp, _wlb_state_path(unit))
    except OSError as exc:
        spawner.log.warning("wlb-session: stan sesji %s nie zapisany: %s", unit, exc)


def _wlb_read_state(unit):
    try:
        with open(_wlb_state_path(unit), encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def _wlb_uid_in_range(uid):
    try:
        n = int(uid)
    except (TypeError, ValueError):
        return False
    return _WLB_UID_MIN <= n <= _WLB_UID_MAX


def _wlb_denied(path):
    # Absolutna deny-lista: /workspace jest TRWAŁE (dysk roboczy) i nie wolno na nim sprzątać
    # rekurencyjnie — zwłaszcza /workspace/.wlb-export-queue (kolejka eksportu, #20).
    p = os.path.abspath(path)
    return p == _WLB_DENY_PREFIX or p.startswith(_WLB_DENY_PREFIX + "/")


def _wlb_scratch_path(unit):
    safe = unit.replace("/", "_").replace("..", "_")
    root = os.path.abspath(_WLB_SCRATCH_ROOT)
    p = os.path.abspath(os.path.join(root, safe))
    if not p.startswith(root + "/") or _wlb_denied(p):
        return None
    return p


def _wlb_prepare_scratch(spawner, user, unit, uid):
    # Dedykowany scratch per-unit na tmpfs (/run) — POZA trwałym /workspace. TMPDIR sesji
    # wskazuje tutaj, więc pliki tymczasowe badacza nie lądują na dysku roboczym.
    if not _wlb_uid_in_range(uid):
        spawner.log.warning("wlb-session: scratch pominięty — uid %r poza zakresem badaczy", uid)
        return ""
    path = _wlb_scratch_path(unit)
    if path is None:
        spawner.log.warning("wlb-session: scratch poza allowlistą (%s) — pomijam", unit)
        return ""
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
        os.chmod(path, 0o700)
    except OSError as exc:
        spawner.log.warning("wlb-session: scratch %s nie utworzony: %s", path, exc)
        return ""
    try:
        pw = pwd.getpwnam(user)
        os.chown(path, pw.pw_uid, pw.pw_gid)
    except (KeyError, OSError) as exc:
        # Właściciel to wzmocnienie, nie warunek działania — sesja i tak startuje.
        spawner.log.warning("wlb-session: chown scratch %s pominięty: %s", path, exc)
    return path


def _wlb_unlink_owned(spawner, path, uid):
    # Tylko JAWNE artefakty (nie katalogi), tylko właściciel = badacz, nigdy kolejka eksportu.
    if "/.wlb-export-queue/" in path:
        return False
    try:
        st = os.lstat(path)
    except OSError:
        return False
    if stat.S_ISDIR(st.st_mode) or st.st_uid != int(uid):
        return False
    try:
        os.unlink(path)
    except OSError as exc:
        spawner.log.warning("wlb-session: nie usunięto %s: %s", path, exc)
        return False
    return True


def _wlb_remove_scratch(spawner, path, uid):
    if not path or not _wlb_uid_in_range(uid):
        return
    root = os.path.abspath(_WLB_SCRATCH_ROOT)
    p = os.path.abspath(path)
    if not p.startswith(root + "/") or _wlb_denied(p):
        spawner.log.warning("wlb-session: odmowa sprzątania scratch %s (poza allowlistą)", p)
        return
    try:
        shutil.rmtree(p)
    except FileNotFoundError:
        pass  # idempotentnie: brak katalogu to sukces
    except OSError as exc:
        spawner.log.warning("wlb-session: scratch %s nie usunięty: %s", p, exc)


def _wlb_reap_display(spawner, user, uid):
    # Artefakty display-scoped TYLKO dla zwalnianego konta (właściciel = uid badacza):
    # gniazda/locki X, pliki .vnc (pid/log) oraz wpis xauth dla tego DISPLAY. Nie ruszamy
    # całego .Xauthority (trwały, współdzielony) ani katalogów.
    if not _wlb_uid_in_range(uid):
        return
    displays = set()
    sock_dir = os.path.join(_WLB_TMP_ROOT, ".X11-unix")
    try:
        names = os.listdir(sock_dir)
    except OSError:
        names = []
    for name in names:
        if not re.fullmatch(r"X\d+", name):
            continue
        if _wlb_unlink_owned(spawner, os.path.join(sock_dir, name), uid):
            displays.add(name[1:])
    try:
        names = os.listdir(_WLB_TMP_ROOT)
    except OSError:
        names = []
    for name in names:
        m = re.fullmatch(r"\.X(\d+)-lock", name)
        if m and _wlb_unlink_owned(spawner, os.path.join(_WLB_TMP_ROOT, name), uid):
            displays.add(m.group(1))
    try:
        home = pwd.getpwnam(user).pw_dir
    except KeyError:
        home = ""
    if home:
        vnc = os.path.join(home, ".vnc")
        try:
            names = os.listdir(vnc)
        except OSError:
            names = []
        for name in names:
            if name.endswith(".pid") or name.endswith(".log"):
                _wlb_unlink_owned(spawner, os.path.join(vnc, name), uid)
    for d in sorted(displays):
        try:
            subprocess.run(["xauth", "-f", _WLB_XAUTHORITY, "remove", ":" + d],
                           check=False, timeout=_WLB_CLEAN_TIMEOUT_S)
        except Exception as exc:  # noqa: BLE001 — sprzątanie nie może blokować stopu
            spawner.log.warning("wlb-session: xauth remove :%s pominięty: %s", d, exc)


def _wlb_cleanup_session(spawner, user, unit, uid):
    # FAIL-SECURE: każdy krok ma własną osłonę; awaria to warning, nie wyjątek.
    if not _wlb_uid_in_range(uid):
        spawner.log.warning("wlb-session: sprzątanie pominięte — uid %r poza zakresem badaczy", uid)
        return
    _wlb_remove_scratch(spawner, _wlb_scratch_path(unit), uid)
    _wlb_reap_display(spawner, user, uid)


def wlb_pre_spawn_hook(spawner):
    user, uid, unit, _ = _wlb_ident(spawner)
    lab, lab_source = _wlb_lab(spawner)
    stale = _wlb_read_state(unit)
    if stale and stale.get("session_id"):
        # osierocona sesja (restart huba / zgubiony post_stop): domknij jawnie. Brak stopu to
        # pusty argument -> null w rekordzie, nie epocha 0 udajaca 1970 rok.
        _wlb_run(spawner, [_WLB_USAGE_RECORD, unit, stale["session_id"], lab,
                           str(stale.get("start_wall", "")), "", "",
                           "interrupted:" + lab_source],
                 "rekord_użycia_interrupted")
    try:
        scratch = _wlb_prepare_scratch(spawner, user, unit, uid)
        if scratch:
            env = dict(getattr(spawner, "environment", None) or {})
            env["TMPDIR"] = scratch
            spawner.environment = env
            spawner._wlb_scratch = scratch
    except Exception as exc:  # noqa: BLE001 — brak scratch nie może blokować spawnu
        spawner.log.warning("wlb-session: przygotowanie scratch nie powiodło się: %s", exc)
    spawner._wlb_session = uuid.uuid4().hex
    spawner._wlb_start = time.monotonic()
    spawner._wlb_start_wall = time.time()
    _wlb_write_state(spawner, unit, {"session_id": spawner._wlb_session,
                                     "start_wall": int(spawner._wlb_start_wall),
                                     "lab_source": lab_source})
    _wlb_run(spawner, [_WLB_SESSION_LOG, "start", user, uid, spawner._wlb_session, lab],
             "session_start")


def wlb_post_stop_hook(spawner):
    user, uid, unit, sid = _wlb_ident(spawner)
    lab, lab_source = _wlb_lab(spawner)
    state = _wlb_read_state(unit) or {}
    sid = getattr(spawner, "_wlb_session", "") or state.get("session_id", "")
    start_wall = getattr(spawner, "_wlb_start_wall", None)
    start_mono = getattr(spawner, "_wlb_start", None)
    if start_wall is None and state.get("start_wall"):
        start_wall = state["start_wall"]  # atrybuty zginely z restartem huba — stan ratuje czas
    # Czas trwania: najpierw zegar monotoniczny (odporny na skoki zegara sciennego); gdy zginal z
    # restartem huba, licz z zegara sciennego na podstawie odzyskanego start_wall. NIGDY 0 udajace
    # sesje zerowej dlugosci — to byloby to samo klamstwo, ktoremu zapobiega pusty argument -> null.
    # Brak obu zrodel -> pusty argument (null + "duration_unavailable" w rekordzie).
    if start_mono is not None:
        duration = str(int(time.monotonic() - start_mono))
    elif start_wall is not None:
        duration = str(int(time.time() - start_wall))
    else:
        duration = ""
    _wlb_run(spawner, [_WLB_SESSION_LOG, "stop", user, uid, sid, lab, duration],
             "session_stop")
    if start_wall is not None:
        _wlb_run(spawner, [_WLB_USAGE_RECORD, unit, sid, lab,
                           str(int(start_wall)), str(int(time.time())), duration, lab_source],
                 "rekord_użycia")
    try:
        _wlb_cleanup_session(spawner, user, unit, uid)
    except Exception as exc:  # noqa: BLE001 — sprzątanie nie może blokować stopu
        spawner.log.warning("wlb-session: sprzątanie sesji nie powiodło się: %s", exc)
    try:
        os.remove(_wlb_state_path(unit))
    except OSError:
        pass


c.Spawner.pre_spawn_hook = wlb_pre_spawn_hook
c.Spawner.post_stop_hook = wlb_post_stop_hook
