#!/usr/bin/env python3
"""Rekord użycia zakonczonej sesji (#98) — JSONL do /var/log/wlb/sessions.

Osobno od SIEM (§21): dane operacyjne do planowania pojemności, nie bezpieczeństwa.
Pisane z post_stop_hooka (80-wlb-session.py).

Zasady kontraktu v1 (fix #98, wg przeglądu):
- zero tylko po poprawnym odczycie; brak/niepoprawny pomiar to null + powód
  (`status`/`metrics_quality`), nie zeron udające dane;
- próbka musi pasować tozsamością: ten sam BOOT_ID, nazwa jednostki od spawnera
  (nie ze sklejania loginu) i czas próbki w oknie sesji — inaczej to metryka
  z cudzej lub zeszłej sesji i trafia do null;
- JSON przez json.dumps(allow_nan=False) — ani nazwa, ani lab nie wstrzykna
  pola/znaku kontrolnego do rekordu; rekord musi parsowac się caly.

Użycie: wlb-usage-record <unit> <hub_session> <lab> <start_epoch> <stop_epoch> \
    <duration_s> [lab_source]
Wynik: 0 zawsze przy zapisie rekordu (nawet częściowego); brak rekordu tylko przy
błedzie użycia (zly liczba argumentów) — hook nie moze zalexec od raportowania.
"""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path
from typing import Any

SCHEMA_VERSION = 1
UINT64_MAX = 18446744073709551615
# swiat tolerancji: probka moze byc chwile przed startem (timer) i tuż po stopie
SAMPLE_WINDOW_SLACK_S = 300


def nonneg_int(value: str) -> int | None:
    """Nieujemna liczba całkowita różna od konwencji „nie ustawiono" systemd."""
    v = value.strip()
    if not v.isdigit() or int(v) == UINT64_MAX:
        return None
    return int(v)


def iso(epoch: int | None) -> str | None:
    if epoch is None:
        return None
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def read_sample(run_dir: Path, unit: str) -> dict[str, str]:
    """Para klucz=wartosć z próbki samplera; plik nazywa jednostka ze wzgledu na systemctl."""
    kv = run_dir / f"{unit}.kv"
    sample: dict[str, str] = {}
    try:
        for line in kv.read_text(encoding="utf-8").splitlines():
            if "=" in line:
                k, _, v = line.partition("=")
                sample[k] = v
    except OSError:
        pass
    return sample


def current_boot_id() -> str:
    # nadpisanie sciezki tylko dla testow; w obrazie to zawsze plik kernela
    path = Path(os.environ.get("WLB_BOOT_ID_FILE", "/proc/sys/kernel/random/boot_id"))
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def match_sample(sample: dict[str, str], start: int | None, stop: int | None) -> tuple[bool, list[str]]:
    """Czy próbka nalezy do tej sesji. Zwaca (ok, powody_odrzucenia)."""
    reasons: list[str] = []
    if not sample:
        return False, ["sample_missing"]
    boot = current_boot_id()
    if boot and sample.get("BootID") and sample["BootID"] != boot:
        return False, ["sample_from_other_boot"]
    if start is None or stop is None:
        return False, ["sample_window_unknown"]
    sampled = nonneg_int(sample.get("SampledAtEpoch", ""))
    if sampled is None:
        reasons.append("sample_untimestamped")
    elif not (start - SAMPLE_WINDOW_SLACK_S <= sampled <= stop + SAMPLE_WINDOW_SLACK_S):
        reasons.append("sample_outside_session_window")
    return (not reasons), reasons


def build_record(unit: str, session_id: str, lab: str, lab_source: str,
                 start: int | None, stop: int | None, duration: int | None) -> dict[str, Any]:
    run_dir = Path(os.environ.get("WLB_USAGE_RUN_DIR", "/run/wlb/usage"))
    sample, quality = {}, []
    ok, reasons = match_sample(read_sample(run_dir, unit), start, stop)
    if ok:
        sample = read_sample(run_dir, unit)
    else:
        quality = reasons

    mem = nonneg_int(sample.get("MemoryPeak", "")) if sample else None
    cpu_ns = nonneg_int(sample.get("CPUUsageNSec", "")) if sample else None
    itv: float | None = None
    if sample:
        try:
            itv = float(sample["CPUIntervalMax"]) if sample.get("CPUIntervalMax") else None
        except ValueError:
            quality.append("cpu_interval_unavailable")
        if mem is None:
            quality.append("memory_peak_unavailable")
        if cpu_ns is None:
            quality.append("cpu_time_unavailable")
    if duration is None:
        quality.append("duration_unavailable")

    if not sample:
        status = "no_samples"
    elif mem is not None and cpu_ns is not None and duration is not None and not quality:
        status = "complete"
    else:
        status = "partial"

    return {
        "schema_version": SCHEMA_VERSION,
        "hub_session": session_id,
        "unit": unit,
        "user": unit.removesuffix(".service"),
        "lab": lab or None,
        "lab_source": lab_source,
        "start_time": iso(start),
        "stop_time": iso(stop),
        "duration_seconds": duration,
        "memory_peak_bytes": mem,
        "cpu_time_seconds": round(cpu_ns / 1e9, 3) if cpu_ns is not None else None,
        "cpu_interval_max_cores": itv,
        "sample": {
            "boot_id": sample.get("BootID") or None,
            "invocation_id": sample.get("InvocationID") or None,
            "sampled_at": iso(nonneg_int(sample.get("SampledAtEpoch", ""))) if sample else None,
        } if sample else None,
        "status": status,
        "quality": quality,
    }


def main(argv: list[str]) -> int:
    if len(argv) < 7:
        print("użycie: wlb-usage-record <unit> <sid> <lab> <start> <stop> <dur> [lab_source]",
              file=sys.stderr)
        return 2
    unit, sid, lab = argv[1][:120], argv[2][:64], argv[3][:120]
    lab_source = argv[7] if len(argv) > 7 and argv[7] else "unknown"
    nums = [nonneg_int(a) for a in argv[4:7]]
    # czas moze byc duży; duration sensownie do roku — UINT64_MAX odrzucony przez nonneg_int
    start, stop, duration = nums
    record = build_record(unit, sid, lab, lab_source, start, stop, duration)
    out_dir = Path(os.environ.get("WLB_USAGE_OUT_DIR", "/var/log/wlb/sessions"))
    os.umask(0o027)  # rekordy dotycza cudzych sesji — plik 0640 od narodzin, nie 0644
    out_dir.mkdir(parents=True, exist_ok=True)
    line = json.dumps(record, ensure_ascii=False, allow_nan=False, sort_keys=True)
    with open(out_dir / f"usage-{time.strftime('%Y%m%d', time.gmtime())}.jsonl",
              "a", encoding="utf-8") as fh:
        fh.write(line + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
