# Budżety wydajności (stage 6a). Kierunek każdego progu jest JAWNY w ci/perf_summary.py
# (mapa DIRECTIONS) — sufiks nazwy metryki nie decyduje o porównaniu. Wartości `*_ms` / `*_s`
# mają górny limit, `*_mbps` dolny, ale nowa metryka bez wpisu w DIRECTIONS jest błędem konfiguracji.
# To budżety REGRESJI (wykrywają, że obraz zwolnił), a NIE wymagania produktowe. Mierzone na
# runnerze CI (~2 vCPU / ~7 GB) w zagnieżdżonej wirtualizacji; VM dobiera zasoby do hosta
# (ci/perf.sh → perf_vm_resources), więc wartości nie odnoszą się do docelowego sprzętu
# (8 vCPU / 32 GB / NVMe — osobny profil, #10/M3). Wartość metryki = mediana PERF_REPEAT powtórzeń.
#
# PROGI WSTĘPNE, NIE KALIBRACJA (#10): punktem wyjścia był pojedynczy przebieg 6a — GitHub run
# 42238306860 (PERF_REPEAT=3, obraz wlb-general na runnerze 2 vCPU). Próg = obserwacja + zapas na
# zmienność zagnieżdżonej wirtualizacji (np. cold-start python_import_pandas skakał 766↔335 ms
# w jednym przebiegu). Komentarz przy metryce podaje obserwację [min..max] z tego przebiegu.
# Dwa zielone przebiegi NIE dowodzą braku false-FAIL ani nie kalibrują progu; potrzeba serii na
# tym samym digestcie obrazu i analizy n/mediany/rozrzutu (patrz #10).
# boot_to_ready_s obejmuje CAŁY tests/run-local.sh (overlay, PKI, seed, QEMU, SSH, cloud-init,
# firstboot), nie sam boot gościa ani gotowość UI — nie porównywać z SLA.
# hub_login_ms nawiązuje do OPZ DO.5 (2 s, pułap PRODUKTOWY) — próg regresji 1000 ms jest
# ciaśniejszy niż pułap; lokalny hub w VM to ~0,3 s, więc 1 s łapie ~3× spowolnienie.
# Uwaga: to nie jest dowód DO.5 na ścieżce użytkownika (UI/OIDC/MFA/sieć) — patrz #10.
boot_to_ready_s=180          # obs. 35 s (1 próbka/przebieg — boot jednorazowy); zapas ×5 na zmienność startu VM
hub_login_ms=1000            # obs. 278..319 ms; pułap produktowy DO.5=2000 ms (patrz wyżej)
spawn_first_ms=3000          # obs. 1042..1046 ms
python_import_pandas_ms=2000 # obs. 335..766 ms (cold-start pierwszego importu podbija górę)
pandas_groupby_5m_ms=500     # obs. 95..101 ms
r_load_hades_ms=6000         # obs. 2127..2418 ms
workspace_write_mbps=60      # obs. 96..132 MiB/s (próg min — łapie spadek poniżej ~0,6× obserwacji)
workspace_read_mbps=2000     # obs. 5019..5565 MiB/s (cache hosta — bardzo zmienne, próg luźny)
