# Budżety wydajności (stage 6). *_ms / *_s — wartość maksymalna, *_mbps — minimalna.
# Mierzone na runnerze CI (4 vCPU, VM testowa 4 vCPU / 8 GB, zagnieżdżona wirtualizacja) —
# docelowy sprzęt (NVMe, bez zagnieżdżenia) powinien mieć wyraźny zapas.
boot_to_ready_s=600          # start VM -> cloud-init + wlb-firstboot zakończone
hub_login_ms=2000
spawn_first_ms=30000
python_import_pandas_ms=5000
pandas_groupby_5m_ms=5000
r_load_hades_ms=30000
workspace_write_mbps=50
workspace_read_mbps=50
