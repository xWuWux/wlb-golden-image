# /etc/wlb/lab.env — parametry Laboratorium, zapisywane przez cloud-init (write_files).
# Czyta je /usr/local/sbin/wlb-firstboot. Format: KLUCZ=wartość (składnia powłoki).

# Wymagane
LAB_NAME=lab-example01              # identyfikator Laboratorium (zgodny z hostname)
HUB_ADMIN_USER=admin-klienta        # Administrator Klienta Środowiska WLB — jedyny admin huba

# Proxy z allowlistą (jedyne wyjście z VM)
PROXY_URL=http://10.20.0.10:3128
NO_PROXY=localhost,127.0.0.1,.wlb.local
PYPI_INDEX_URL=https://pypi-mirror.wlb.local/simple
CRAN_MIRROR_URL=https://cran-mirror.wlb.local

# Adresy, z którymi procesy badaczy mogą się łączyć bezpośrednio (nftables, obrona w głębi).
# Format: IPv4[/maska]:PORT, rozdzielone spacją. Zwykle: proxy + baza warstwy Gold (OMOP CDM).
EGRESS_ALLOW="10.20.0.10:3128 10.30.0.5:5432"

# Skąd wolno łączyć się z VM
ADMIN_SSH_CIDR=10.10.0.0/24         # sieć administracyjna platformy
HUB_ALLOWED_CIDR=10.10.1.0/24       # portal WLB / bramka VDI

# Serwery czasu (wewnętrzne — VM nie ma dostępu do publicznych). Rozdzielone spacją.
NTP_SERVERS="10.10.0.2 10.10.0.3"

# Centralny SIEM (Wazuh / OpenSearch) — puste = logi tylko lokalnie
SIEM_HOST=10.40.0.20
SIEM_PROTOCOL=tcp
# TLS z weryfikacją nazwy serwera (domyślnie; §20). SIEM_TLS_NAME = nazwa (SAN/CN) z certyfikatu SIEM —
# wymagana, gdy SIEM_HOST to adres IP. SIEM_CA_CERT = CA, które wystawiło ten certyfikat (write_files).
# SIEM_TLS=0 wyłącznie na jawną decyzję administratora: logi idą otwartym tekstem (ostrzeżenie w logu).
SIEM_TLS=1
SIEM_TLS_NAME=siem.wlb.local
SIEM_CA_CERT=/etc/wlb/siem-ca.pem
SIEM_PORT=6514                      # domyślnie 6514 przy TLS (RFC 5425), 514 bez TLS

# 1 = lokalny test obrazu (dane przykładowe w /data-mart i /sluza-in). Nigdy w produkcji.
LOCAL_TEST_MODE=0
